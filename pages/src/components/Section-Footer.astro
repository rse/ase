/*  page footer: the QR-code trigger, the copyright and license notice, the
    Discussions link, and the stacked variant of the install call-to-action.  */

import QRCode    from "./Widget-QR-Code.astro"
import StickyCTA from "./Widget-Sticky-CTA.astro"
import { site }  from "../data/site.ts"
---
{/*  "relative" is load-bearing: the page decorations live inside the
     "isolate" <main>, which hence paints as one unit above every plain block
     following it. On a page shorter than the viewport the one-viewport-tall
     <GlowTop/> band bleeds past the bottom edge of <main> and would cover the
     footer. Positioning the footer lifts it back above that bleed.  */}
<footer id="page-footer" class="relative border-t border-border/60 bg-background-secondary">
    <div class="mx-auto flex max-w-4xl flex-wrap items-center gap-5 px-6 py-5 text-sm text-foreground-muted">
        {/*  QR-code trigger: opens the `#qr-modal` popup showing the QR code for
             the site URL. Opening is wired in Modal-QR.astro (which owns the
             popup and its closing). The icon sits at the accent colour and turns
             white (the foreground colour) while hovered.  */}
        <button
            id="qr-toggle"
            type="button"
            aria-label="Show QR code for this site"
            aria-controls="qr-modal"
            class="inline-flex shrink-0 cursor-pointer items-center text-accent transition-colors hover:text-foreground"
        >
            <QRCode class="h-20 w-20 transition-colors"/>
        </button>
        <div>
            <p>
                <strong>ASE — Agentic Software Engineering</strong>
            </p>
            <p class="mt-2">
                Copyright &copy; 2025-2026 <a href="/author/">Dr. Ralf S. Engelschall</a><br/>
                Licensed under <a href="https://spdx.org/licenses/Apache-2.0">Apache-2.0</a> as Open Source
            </p>
            <p class="mt-2">
                Questions or feedback? Join the <a href={site.discussions}>GitHub Discussions</a>.
            </p>
        </div>

        {/*  the install call-to-action, stacked into its standing variant, so
             the call survives the dismissal of the sticky bar above  */}
        <div class="ml-auto w-full max-w-xs">
            <StickyCTA variant="block"/>
        </div>
    </div>
</footer>
