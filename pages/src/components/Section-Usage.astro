/*  "Usage" section: a text/terminal pair laid out as a two-column row,
    mirroring the highlights rows, followed by the full skill catalog panel
    whose skill names open the shared man-page modal on click.  */

import GlowSide        from "./Widget-Glow-Side.astro"
import Terminal        from "./Widget-Terminal.astro"
import Diagram         from "./Widget-Diagram.astro"
import Annotation      from "./Widget-Annotation.astro"
import { skillGroups } from "../data/skills.ts"
import Compass         from "@lucide/astro/icons/compass"
import Footprints      from "@lucide/astro/icons/footprints"
import Search          from "@lucide/astro/icons/search"
import BookOpenText    from "@lucide/astro/icons/book-open-text"

/*  arrange the skill groups into the five catalog columns, where the
    third column stacks "Quick Mode" and "Sync Mode" vertically instead
    of letting the sixth group wrap into an own grid row  */
const columns = [
    [ "Standalone Mode 1/2" ],
    [ "Standalone Mode 2/2" ],
    [ "Quick Mode", "Sync Mode" ],
    [ "Funnel Mode" ],
    [ "Task Mode" ]
].map((labels) => labels.map((label) => skillGroups.find((group) => group.label === label)!))
---
<section id="usage" class="mt-4 sm:mt-12 relative isolate mx-auto max-w-4xl px-6 py-8">
    <header id="getstarted" class="ase-section-head" data-reveal>
        <h2 class="ase-h2 relative inline-block">
            <Annotation flat class="right-0 translate-x-1/4">
                You bring the intent,<br/>
                ASE brings the skills!
            </Annotation>
            Quickly <span class="text-accent">Get Started</span>
        </h2>
        <p class="ase-lead ase-justify">
            <b>ASE</b> is a comprehensive toolkit with 54 individual
            skills and initially can be overwhelming, as there <i>intentionally</i> is no
            pre-defined workflow with a fixed beginning. Instead, <b>ASE</b>{" "}
            keeps you in the driver's seat, but as a consequence
            for most tasks you have to at least trigger the desired <b>ASE</b> actions yourself.
            The following gives you a few hints on how to quickly get started.
        </p>
    </header>

    <div class="mt-12 flex flex-col gap-12">
        <div class="ase-grid-split">
            <div class="lg:order-1 relative isolate" data-reveal="right">
                <p class="ase-eyebrow">Online Help</p>
                <h3 class="ase-h3 flex items-start gap-2">
                    <Compass class="mt-1 h-6 w-6 shrink-0 sm:h-7 sm:w-7" stroke-width={0.75}/>
                    <span>From Intention to Skills</span>
                </h3>
                <p class="mt-4 text-foreground-secondary ase-justify">
                    <b>ASE</b> skills are primarily intended to be
                    triggered by the user through so-called "slash commands"
                    <b><code>/ase-xxx-xxx</code></b>. In order to find the right
                    commands, just use the <b><code>ase-help-intent</code></b>
                    skill and express your intention. It will show you
                    which particular slash commands (potentially even with their suitable options
                    and arguments) can be used by you to achieve your intention.
                </p>
                <p class="ase-indent-p text-foreground-secondary">
                    Once you have found the suitable skill, either execute the
                    proposed corresponding slash commands, or use the <b><code>ase-help-skill</code></b>
                    skill to get a catalog of all available skills or show the
                    manual page of an individual skill to find out more about the skill.
                    Or alternatively, read the <a href="#deepdive">manual pages</a> directly online below.
                </p>
            </div>
            <div class="lg:order-2 relative isolate" data-reveal="left">
                {/*  the man page opens on this very page, so closing it
                     returns the reader to the terminal they came from  */}
                <Terminal
                    prefix="Claude Code"
                    title="Example Prompts"
                    helpPage={Astro.url.pathname}
                    commands={[
                        "**/ase-help-intent** create a \"hello\" CLI command which prints \"Hello World\" in red to the terminal",
                        "**/ase-help-intent** find 10 new clever ideas for Software Engineering skills",
                        "**/ase-help-intent** locate a good library for option parsing in TypeScript",
                    ]}
                />
                <Terminal
                    class="mt-8"
                    prefix="Claude Code"
                    title="Example Prompts"
                    helpPage={Astro.url.pathname}
                    commands={[
                        "**/ase-help-skill**",
                        "**/ase-help-skill** ase-meta-brainstorm",
                        "**/ase-help-skill** ase-code-edit"
                    ]}
                />
            </div>
        </div>
    </div>

    <header id="overview" class="mt-24 ase-section-head" data-reveal>
        <GlowSide variant="text" side="left" />
        <h2 class="ase-h2 relative inline-block">
            <Annotation flat class="right-0 translate-x-1/4">
                Want an overview?<br/>
                Check out this!
            </Annotation>
            Your Skill <span class="text-accent">Overview</span>
        </h2>
        <p class="ase-lead ase-justify">
            <b>ASE</b> provides both stand-alone skills, which can be called at any time and fully
            independently, and related skills, which should be called in sequence to form a
            workflow.
        </p>
    </header>

    <div class="mt-4 flex flex-col gap-12">
        <div class="ase-grid-split">
            <div class="relative isolate lg:order-1" data-reveal="left">
                <GlowSide variant="text" side="right" />
                <p class="ase-eyebrow">Skills &amp; Workflows</p>
                <h3 class="ase-h3 flex items-start gap-2">
                    <Footprints class="mt-1 h-6 w-6 shrink-0 sm:h-7 sm:w-7" stroke-width={0.75}/>
                    <span>Step-Wise Driving,<br/>You In The Loop</span>
                </h3>
                <p class="mt-4 text-foreground-secondary ase-justify">
                    <b>ASE</b> provides its
                    various skills to let the engineer trigger the
                    next steps. Some skills are stand-alone, others
                    are part of a particular operation mode that
                    chains skills into a repeatable workflow.
                    The diagram to the right gives you a compact
                    overview of the skills and their intended
                    operation modes.
                </p>
            </div>
            <div class="lg:order-2" data-reveal="right">
                <Diagram src="/assets/workflow.svg" label="ASE usage workflow diagram" />
            </div>
        </div>
    </div>

    <header id="deepdive" class="mt-24 ase-section-head" data-reveal>
        <GlowSide variant="text" side="right" />
        <h2 class="ase-h2 relative inline-block">
            <Annotation flat class="right-0 translate-x-1/4">
                Want more details?<br/>
                Browse here!
            </Annotation>
            Your Skill <span class="text-accent">Deep-Dive</span>
        </h2>
        <p class="ase-lead ase-justify">
            <b>ASE</b> provides many individual skills and each one accepts options and arguments.
            Fortunately, they are all documented in individual Unix-style manpages you can browse
            and search.
        </p>
    </header>

    <div class="mt-12 flex flex-col gap-12">
        <div class="relative overflow-hidden rounded-xl border border-border-strong bg-background-elevated/60 p-6 shadow-xl sm:p-8" data-reveal>

            {/*  the search field and browser button share the top line of the
                 panel, above the catalog columns, the search field flush left
                 and the browser button flush right  */}
            <div class="mb-8 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                {/*  the magnifier sits in an own leading segment, tinted exactly
                     like the browser button, so the border, the rounding and the
                     focus state move from the input to the shell and both parts
                     read as one single control. The shell itself stays
                     transparent and only the input carries the opaque
                     background, so the segment tint composites over the very
                     same panel background as the button does.  */}
                <div class="flex w-64 items-stretch overflow-hidden rounded-lg border border-border-strong focus-within:border-accent">
                    <span class="flex items-center border-r border-border-strong bg-accent/10 px-2.5 text-foreground-muted">
                        <Search class="h-4 w-4 shrink-0" stroke-width={1}/>
                    </span>
                    <input
                        type="search"
                        data-help-search
                        autocomplete="off"
                        placeholder="Search all manpages…"
                        aria-label="Search man-pages"
                        class="min-w-0 flex-1 bg-background px-3 py-2 text-sm text-foreground placeholder:text-foreground-muted focus:outline-none"
                    />
                </div>
                <button type="button" class="flex w-64 cursor-grab items-center justify-center gap-2 bg-accent/10 text-sm ase-btn" data-help-id={skillGroups[0].skills[0]}>
                    <BookOpenText class="h-4 w-4 shrink-0" stroke-width={1}/>
                    Open Manpage Browser
                </button>
            </div>

            <div class="grid grid-cols-1 gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-5">
                {columns.map((column) => (
                    <div class="space-y-8">
                        {column.map((group) => {
                            /*  split a group label like "Standalone Mode 1/2" around
                                " Mode" into the leading word and an optional trailing
                                "1/2" fraction, so the header keeps its original
                                two-line "<word><br/>Mode [fraction]" layout while the
                                label text lives solely in the shared catalog.  */
                            const [ word, fraction ] = group.label.split(" Mode")
                            return (
                                <div>
                                    <p class="text-sm font-bold uppercase tracking-wider text-accent">{word}<br/>Mode {fraction.trim() && <span class="font-light">{fraction.trim()}</span>}</p>
                                    <ul class="mt-3 space-y-1 text-[0.90625rem] leading-none text-foreground-secondary">
                                        {group.skills.map((id) => {
                                            const idx    = id.lastIndexOf("-")
                                            const prefix = id.slice(0, idx + 1)
                                            const name   = id.slice(idx + 1)
                                            return (
                                                <li>{prefix}<button type="button" class="cursor-grab text-accent transition-colors hover:text-white" data-help-id={id}><b>{name}</b></button></li>
                                            )
                                        })}
                                    </ul>
                                </div>
                            )
                        })}
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>
