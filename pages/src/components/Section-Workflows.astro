/*  "Workflows" section: the operation modes text/diagram pair, the task
    management with its lifecycle models, task boards, and agents, the
    specification workflows, followed by seven text/terminal pairs laid out
    as two-column rows, each pairing a coding workflow description with its
    Claude Code CLI prompt transcript in a Terminal box.  */

import GlowSide   from "./Widget-Glow-Side.astro"
import Terminal   from "./Widget-Terminal.astro"
import Diagram    from "./Widget-Diagram.astro"
import Screenshot from "./Widget-Screenshot.astro"
import Annotation from "./Widget-Annotation.astro"

/*  the workflow icon for the operation modes opening the section, plus
    one icon per workflow, picked for the trait that distinguishes the workflow
    from its neighbours: a bare chat bubble for the plain prompt, a bolt for
    speed, a double check for the added grilling and verification, a clipboard
    for the single ad-hoc plan, stacked layers for the co-existing task plans,
    a take-off for the professional planning, a refresh cycle for the
    round-trip reconciliation, a sticky note for the
    free-form user-story card, and a checked book for the SpecBook specification model,
    plus a route for the lifecycle models, a Kanban board for the task boards, and a
    bot for the autonomous agents of the task management  */

import Workflow      from "@lucide/astro/icons/workflow"
import MessageSquare from "@lucide/astro/icons/message-square"
import Zap           from "@lucide/astro/icons/zap"
import CheckCheck    from "@lucide/astro/icons/check-check"
import ClipboardList from "@lucide/astro/icons/clipboard-list"
import Layers        from "@lucide/astro/icons/layers"
import PlaneTakeoff  from "@lucide/astro/icons/plane-takeoff"
import RefreshCw     from "@lucide/astro/icons/refresh-cw"
import StickyNote    from "@lucide/astro/icons/sticky-note"
import BookCheck     from "@lucide/astro/icons/book-check"
import Route         from "@lucide/astro/icons/route"
import SquareKanban  from "@lucide/astro/icons/square-kanban"
import Bot           from "@lucide/astro/icons/bot"
---
<section class="mt-4 sm:mt-12 relative isolate mx-auto max-w-4xl px-6 py-8">
    <header id="operation-modes" class="ase-section-head" data-reveal>
        <h2 class="ase-h2">
            <Annotation flat class="hidden sm:block right-0 -translate-x-1/2">
                Pick the gear<br/>
                that fits the<br/>
                task at hand!
            </Annotation>
            Understand <span class="text-accent">Operation Modes</span>
        </h2>
        <p class="ase-lead ase-justify">
            On top of the standard Agentic AI Coding tool modes{" "}
            <i>Ad-Hoc Mode</i> and <i>Plan Mode</i>,{" "}
            <b>ASE</b> adds three distinct operation modes
            to provide even more flexibility and power.
        </p>
    </header>

    <div class="mt-12 flex flex-col gap-12">
        <div class="ase-grid-split">
            <div class="relative isolate lg:order-1" data-reveal="right">
                <p class="ase-eyebrow">Operation Modes</p>
                <h3 class="ase-h3 flex items-start gap-2">
                    <Workflow class="mt-1 h-6 w-6 shrink-0 sm:h-7 sm:w-7" stroke-width={0.75}/>
                    <span>Advanced Operation Modes</span>
                </h3>
                <div class="mt-4 text-foreground-secondary">
                    <p class="ase-justify">
                        <b class="text-accent">Direct Mode</b>: The more advanced variant of the{" "}
                        <i>Ad-Hoc Mode</i>, where the
                        agent directly modifies artifacts, but where
                        the underlying <b>ASE</b> tenets are still applied
                        and honored and optionally the prompt and its intent
                        can be relentlessly "grilled" as in <b>Task Mode</b>.
                        Additionally, the right approach can optionally be also selected explicitly,
                        the results can be optionally verified,
                        the operation can be looped until it converges, and
                        the changes can be isolated in a Git worktree.
                    </p>

                    <p class="text-foreground-secondary ase-indent-p ase-justify">
                        <b class="text-accent">Task Mode</b>: The more advanced variant of the{" "}
                        <i>Plan Mode</i>, where the user initially
                        crafts and then continuously refines a task plan.
                        The task plan has a fixed format and is persisted
                        and hence is available across agent sessions. The
                        most prominent feature is that the task plan can be
                        relentlessly "grilled" to ensure that the later
                        implementation by the AI really meets the intentions
                        of the user. Afterwards, the task plan can be drafted,
                        implemented, and finally integrated, either step by step
                        interactively or even fully autonomously.
                    </p>

                    <p class="text-foreground-secondary ase-indent-p ase-justify">
                        <b class="text-accent">Sync Mode</b>: The separated reconciliation mode
                        where the user aligns the code and documentation
                        to the specification and architecture ("forward
                        engineering") or even aligns the specification and
                        architecture to the code and documentation ("reverse
                        engineering"). Additionally, information from foreign
                        sources can be imported into the artifacts, and the
                        specification can be exported into ready-to-consume
                        renderings like HTML or PDF.
                    </p>
                </div>
            </div>
            <div class="lg:order-2 relative" data-reveal="left">
                <Diagram src="/assets/operation-modes-diagram.svg" label="ASE operation modes diagram" />
                <Diagram src="/assets/operation-modes.svg" label="ASE operation modes table" />
            </div>
        </div>
    </div>

    <header id="task-management" class="mt-16 ase-section-head" data-reveal>
        <GlowSide variant="text" side="left" />
        <h2 class="ase-h2">
            <Annotation flat class="hidden sm:block right-0 -translate-x-1/2">
                Engineers decide,<br/>
                agents execute,<br/>
                boards show it!
            </Annotation>
            Your <span class="text-accent">Task Management</span>
        </h2>
        <p class="ase-lead ase-justify">
            In the <b>ASE</b> Task Mode, every task plan is a persisted
            artifact which flows through the states of a task lifecycle model.
            Follow the tasks live on a task board and let autonomous agents
            drive them through the pipeline, while the engineers stay in charge
            of the decisions.
        </p>
    </header>

    <div class="mt-12 flex flex-col gap-12">
        <div class="ase-grid-split">
            <div class="lg:order-1 relative isolate" data-reveal="right">
                <p class="ase-eyebrow">Task State Lifecycle Models</p>
                <h3 class="ase-h3 flex items-start gap-2">
                    <Route class="mt-1 h-6 w-6 shrink-0 sm:h-7 sm:w-7" stroke-width={0.75}/>
                    <span>Lifecycles from Solo to Enterprise</span>
                </h3>
                <p class="mt-4 text-foreground-secondary ase-justify">
                    The lifecycle of a task is modelled through its states,
                    and <b>ASE</b> provides three pre-defined lifecycle models
                    for this. The <b class="text-accent">Solo</b> model is based on
                    a single activity phase and intended for the local use of a
                    solo developer. The <b class="text-accent">Team</b> model is
                    based on the two activity phases <i>Planning</i> and{" "}
                    <i>Implementation</i> and intended for a small team of
                    developers.
                </p>
                <p class="text-foreground-secondary ase-indent-p ase-justify">
                    The <b class="text-accent">Enterprise</b> model is based on the
                    four activity phases <i>Planning</i>, <i>Implementation</i>,{" "}
                    <i>Qualification</i>, and <i>Integration</i> and intended for an
                    enterprise where engineers and agents act in a gated development
                    pipeline. Each phase has an activity state (like IMPLEMENTING),
                    a resting state for its success (like IMPLEMENTED), and a resting
                    state for its failure (like STALLED). In each phase, either an
                    engineer acts and an agent prepares, or an agent acts and an
                    engineer handles the escalations.
                </p>
            </div>
            <div class="lg:order-2 relative isolate" data-reveal="left">
                <Diagram src="/assets/task-states.svg" label="ASE task state lifecycle models" />
                <Terminal
                    class="mt-5"
                    prefix="Shell"
                    helpPage={Astro.url.pathname}
                    commands={[
                        "**ase config set** project.task.lifecycle enterprise",
                        "**ase task list**",
                        "**ase task status** foo PLANNED"
                    ]}
                />
            </div>
        </div>

        <div class="ase-grid-split">
            <div class="lg:order-2 relative isolate" data-reveal="left">
                <GlowSide variant="text" side="right"/>
                <p class="ase-eyebrow">Live Task Boards</p>
                <h3 class="ase-h3 flex items-start gap-2">
                    <SquareKanban class="mt-1 h-6 w-6 shrink-0 sm:h-7 sm:w-7" stroke-width={0.75}/>
                    <span>Task Boards in Terminal and Browser</span>
                </h3>
                <p class="mt-4 text-foreground-secondary ase-justify">
                    The task board shows all tasks of the project live and is
                    identically rendered both in the terminal and in the browser.
                    The <b class="text-accent">lanes</b> view shows the tasks
                    Kanban-style in the lanes of the phases and states of the
                    lifecycle model, where the tasks can be directly transitioned,
                    edited, and created. The <b class="text-accent">graph</b> view
                    shows the dependencies between the tasks and their grouping
                    into epics.
                </p>
                <p class="text-foreground-secondary ase-indent-p ase-justify">
                    The <b class="text-accent">stats</b> view gives insights into the
                    project through the task state distribution, the throughput,
                    the task progress, the AI and human usage tracking, the effort
                    estimations, and the efficiency metrics. Additionally, the
                    board passes prompt-driven edit, estimate, and research requests
                    to the agents.
                </p>
                <Terminal
                    class="mt-5"
                    prefix="Shell"
                    helpPage={Astro.url.pathname}
                    commands={[
                        "**ase task board** **--web**",
                        "**ase task board**"
                    ]}
                />
            </div>
            <div class="lg:order-1 grid grid-cols-2 gap-2" data-reveal="right">
                <Screenshot src="/assets/usp-task-board-wui-1.png" label="Web task board: lanes view"/>
                <Screenshot src="/assets/usp-task-board-tui-1.png" label="Terminal task board: lanes view"/>
                <Screenshot src="/assets/usp-task-board-wui-2.png" label="Web task board: graph view"/>
                <Screenshot src="/assets/usp-task-board-tui-2.png" label="Terminal task board: graph view"/>
                <Screenshot src="/assets/usp-task-board-wui-3.png" label="Web task board: stats view"/>
                <Screenshot src="/assets/usp-task-board-tui-3.png" label="Terminal task board: stats view"/>
            </div>
        </div>

        <div class="ase-grid-split">
            <div class="lg:order-1 relative isolate" data-reveal="right">
                <GlowSide variant="text" side="left"/>
                <p class="ase-eyebrow">Autonomous Agents</p>
                <h3 class="ase-h3 flex items-start gap-2">
                    <Bot class="mt-1 h-6 w-6 shrink-0 sm:h-7 sm:w-7" stroke-width={0.75}/>
                    <span>Agents Driving the Enterprise Pipeline</span>
                </h3>
                <p class="mt-4 text-foreground-secondary ase-justify">
                    For the <b class="text-accent">Enterprise</b> lifecycle model,
                    autonomous agents drive the tasks headless from the planned
                    to the integrated state, each one running in its own process.
                    The <b class="text-accent">implementer</b> claims the PLANNED
                    tasks and implements them into their change sets (IMPLEMENTED,
                    else STALLED). The <b class="text-accent">qualifier</b> reviews
                    the IMPLEMENTED tasks and either leaves the final decision to
                    the engineer or decides by its verdict (QUALIFIED, else DECLINED).
                    The <b class="text-accent">integrator</b> lands the change sets
                    of the QUALIFIED tasks into their targets (INTEGRATED, else DEFERRED).
                </p>
                <p class="text-foreground-secondary ase-indent-p ase-justify">
                    In the Planning phase, the <b class="text-accent">researcher</b>,{" "}
                    <b class="text-accent">rebooter</b>, and <b class="text-accent">condenser</b>{" "}
                    agents research, re-create, and condense the drafted task plans,
                    the <b class="text-accent">estimator</b> estimates their effort,
                    and the <b class="text-accent">editor</b> processes the edit requests
                    of the task boards. A fleet supervises all agents, restarts every
                    exited one, and passes their live presence to the task boards,
                    where the <b class="text-accent">agent-graph</b> view shows the
                    agents along the lifecycle model and the <b class="text-accent">agent-logs</b>{" "}
                    view shows their operations.
                </p>
            </div>
            <div class="lg:order-2" data-reveal="left">
                <div class="grid grid-cols-2 gap-2">
                    <Screenshot src="/assets/usp-task-board-wui-4.png" label="Web task board: agent graph view"/>
                    <Screenshot src="/assets/usp-task-board-tui-4.png" label="Terminal task board: agent graph view"/>
                    <Screenshot src="/assets/usp-task-board-wui-5.png" label="Web task board: agent logs view"/>
                    <Screenshot src="/assets/usp-task-board-tui-5.png" label="Terminal task board: agent logs view"/>
                </div>
                <Terminal
                    class="mt-5"
                    prefix="Shell"
                    helpPage={Astro.url.pathname}
                    commands={[
                        "**ase agent fleet init**",
                        "vi .ase/**fleet.yaml**",
                        "**ase agent fleet start**"
                    ]}
                />
            </div>
        </div>
    </div>

    <header id="specification-workflows" class="mt-24 ase-section-head" data-reveal>
        <GlowSide variant="text" side="left" />
        <h2 class="ase-h2">
            <Annotation flat class="hidden sm:block right-0 -translate-x-1/2">
                Model your spec,<br/>
                for you and the AI!
            </Annotation>
            Your <span class="text-accent">Specification Workflows</span>
        </h2>
        <p class="ase-lead ase-justify">
            <b>ASE</b> allows both agile and traditional specification.
            For this, it allows you to use both small-scale, free-form
            user-stories and/or large-scale, strictly structured specifications.
            Choose the specification "weapon" which fits best for you!
        </p>
    </header>

    <div class="mt-12 flex flex-col gap-12">
        <div class="ase-grid-split">
            <div class="lg:order-1 relative isolate" data-reveal="right">
                <p class="ase-eyebrow">Free-Form User-Story</p>
                <h3 class="ase-h3 flex items-center gap-2">
                    <StickyNote class="h-6 w-6 shrink-0 sm:h-7 sm:w-7" stroke-width={0.75}/>
                    User-Story Task
                </h3>
                <p class="mt-4 text-foreground-secondary ase-justify">
                    The simple and agile approach to development is to iteratively work
                    through many small user-stories, each specifying an individual feature.
                    Every user-story is realized as a task in <b>ASE</b>.
                </p>
            </div>
            <div class="lg:order-2 relative isolate" data-reveal="left">
                <Terminal
                    prefix="Claude Code"
                    helpPage={Astro.url.pathname}
                    commands={[
                        "**/ase-task-edit** foo",
                        "**/ase-task-dissect** foo: [...]",
                        "**/ase-task-grill** foo",
                        "**/ase-task-implement** foo"
                    ]}
                />
            </div>
        </div>

        <div class="ase-grid-split">
            <div class="lg:order-1 relative isolate" data-reveal="right">
                <p class="ase-eyebrow">Checked Specification</p>
                <h3 class="ase-h3 flex items-center gap-2">
                    <BookCheck class="h-6 w-6 shrink-0 sm:h-7 sm:w-7" stroke-width={0.75}/>
                    Specification Model
                </h3>
                <p class="mt-4 text-foreground-secondary ase-justify">
                    The complex and traditional approach to development is to model the solution
                    with a strictly structured and legally binding specification. Such specifications
                    are realized as <a href="https://specbook.tools/">SpecBook</a> models in <b>ASE</b>.
                </p>
            </div>
            <div class="lg:order-2 relative isolate" data-reveal="left">
                <Terminal
                    prefix="Claude Code"
                    helpPage={Astro.url.pathname}
                    commands={[
                        "**/ase-sync-import** [...]",
                        "**/ase-spec-edit** **--grill** [...]",
                        "**/ase-sync-export**",
                        "**/ase-sync-reconcile** **--source** SPEC **--target** CODE,DOCS"
                    ]}
                />
            </div>
        </div>

        <div class="ase-grid-split">
            <div class="lg:order-1" data-reveal="right">
                <Diagram src="/assets/specbook-poster-1.png" label="SpecBook poster 1" />
            </div>
            <div class="lg:order-2" data-reveal="left">
                <Diagram src="/assets/specbook-poster-2.png" label="SpecBook poster 2" />
            </div>
        </div>
    </div>

    <header id="coding-workflows" class="mt-24 ase-section-head" data-reveal>
        <GlowSide variant="text" side="left" />
        <h2 class="ase-h2">
            <Annotation flat class="hidden sm:block right-0 -translate-x-1/2">
                Choose the best<br/>
                tool for the job:<br/>
                2+5 coding workflows!
            </Annotation>
            Your <span class="text-accent">Coding Workflows</span>
        </h2>
        <p class="ase-lead ase-justify">
            <b>ASE</b> is based on individual skills which can both be
            sequentially triggered and partially also automatically
            chained. This way typical practical workflows can be
            realized. The following shows typical coding workflows in the
            Agentic AI Coding tool <b>Anthropic Claude Code CLI</b>.
        </p>
        <p class="ase-indent-p text-foreground-secondary ase-justify">
            Which coding workflow to choose depends on the requirements, the
            desired pros and the acceptable cons. <b>ASE</b> does not
            mandate a particular coding workflow as the particular tasks of
            Software Engineers are too different. In practice, one needs
            nearly all coding workflows, each one at a certain time.
        </p>
    </header>

    <div class="mt-12 flex flex-col gap-12">
        <div class="ase-grid-split">
            <div class="lg:order-1 relative isolate" data-reveal="right">
                <p class="ase-eyebrow">Ad-Hoc Prompt</p>
                <h3 class="ase-h3 flex items-center gap-2">
                    <MessageSquare class="h-6 w-6 shrink-0 sm:h-7 sm:w-7" stroke-width={0.75}/>
                    Simple Prompting
                </h3>
                <p class="mt-4 text-foreground-secondary ase-justify">
                    The simplest approach is a straight and ad-hoc
                    instruction, as provided by <b>Anthropic Claude Code CLI</b>{" "}
                    already without <b>ASE</b> in its standard mode. The pro is its
                    simplicity, the con is its weakness due to missing
                    detail decisions. Use for simple ad-hoc tasks only.
                </p>
            </div>
            <div class="lg:order-2 relative isolate" data-reveal="left">
                <Terminal
                    prefix="Claude Code"
                    helpPage={Astro.url.pathname}
                    commands={[
                        "Create \"hello\" CLI command which prints \"Hello World\" in red to the terminal"
                    ]}
                />
            </div>
        </div>

        <div class="ase-grid-split">
            <div class="lg:order-1 relative isolate" data-reveal="right">
                <p class="ase-eyebrow">Direct Mode #1</p>
                <h3 class="ase-h3 flex items-center gap-2">
                    <Zap class="h-6 w-6 shrink-0 sm:h-7 sm:w-7" stroke-width={0.75}/>
                    Quick &amp; Dirty I
                </h3>
                <p class="mt-4 text-foreground-secondary ase-justify">
                    The simple quick &amp; dirty approach in <b>ASE</b>{" "}
                    is the Direct Mode, which borrows underlying instructions
                    from the <b>ASE</b> Task Mode, but works without
                    the ceremony of the <b>ASE</b> Task Mode. The pro
                    is its speed, the con is that it might require
                    subsequent ad-hoc adjustment promptings, as the
                    expressed intent is still not "grilled" and no
                    "verification" of the result is done.
                    Use for simple and clear ad-hoc tasks only.
                </p>
            </div>
            <div class="lg:order-2 relative isolate" data-reveal="left">
                <GlowSide variant="text" side="right"/>
                <Terminal
                    prefix="Claude Code"
                    helpPage={Astro.url.pathname}
                    commands={[
                        "**/ase-code-edit** Create \"hello\" CLI command which prints \"Hello World\" in red to the terminal"
                    ]}
                />
            </div>
        </div>

        <div class="ase-grid-split">
            <div class="lg:order-1 relative isolate" data-reveal="right">
                <GlowSide variant="text" side="left"/>
                <p class="ase-eyebrow">Direct Mode #2</p>
                <h3 class="ase-h3 flex items-center gap-2">
                    <CheckCheck class="h-6 w-6 shrink-0 sm:h-7 sm:w-7" stroke-width={0.75}/>
                    Quick &amp; Dirty II
                </h3>
                <p class="mt-4 text-foreground-secondary ase-justify">
                    The advanced quick &amp; dirty approach in <b>ASE</b>{" "}
                    is the Direct Mode where the right approach
                    is selected and the
                    expressed intent is "grilled" and the results are
                    verified. The pro is its decent balance between
                    higher speed and good result quality, the con is
                    that it requires more interaction. Use for
                    medium-complex tasks.
                </p>
            </div>
            <div class="lg:order-2 relative isolate" data-reveal="left">
                <Terminal
                    prefix="Claude Code"
                    helpPage={Astro.url.pathname}
                    commands={[
                        "**/ase-code-edit** **--approach** **--grill** **--verify** **full** Create \"hello\" CLI command which prints \"Hello World\" in red to the terminal"
                    ]}
                />
            </div>
        </div>

        <div class="ase-grid-split">
            <div class="lg:order-1 relative isolate" data-reveal="right">
                <p class="ase-eyebrow">Plan Mode</p>
                <h3 class="ase-h3 flex items-center gap-2">
                    <ClipboardList class="h-6 w-6 shrink-0 sm:h-7 sm:w-7" stroke-width={0.75}/>
                    Simple Planning
                </h3>
                <p class="mt-4 text-foreground-secondary ase-justify">
                    The advanced approach is to use the standard plan
                    mode, as provided by <b>Anthropic Claude Code CLI</b> already
                    without <b>ASE</b>. The pro is its convenience and
                    possibility to interactively add detail decisions,
                    the con is its weakness when it comes to multiple
                    plans: these cannot easily co-exist and be edited in
                    parallel. Use for medium-complex tasks under ad-hoc
                    planning.
                </p>
            </div>
            <div class="lg:order-2 relative isolate" data-reveal="left">
                <GlowSide variant="text" side="right"/>
                <Terminal
                    prefix="Claude Code"
                    helpPage={Astro.url.pathname}
                    commands={[
                        "**/plan**",
                        "Create \"hello\" CLI command which prints \"Hello World\" in red to the terminal",
                        "**(3) Change output color to blue**",
                        "**(3) Use NPM package \"chalk\" for coloring**",
                        "**(1) (Yes, and use auto mode)**"
                    ]}
                />
            </div>
        </div>

        <div class="ase-grid-split">
            <div class="lg:order-1 relative isolate" data-reveal="right">
                <GlowSide variant="text" side="left"/>
                <p class="ase-eyebrow">Task Mode #1</p>
                <h3 class="ase-h3 flex items-center gap-2">
                    <Layers class="h-6 w-6 shrink-0 sm:h-7 sm:w-7" stroke-width={0.75}/>
                    Advanced Planning
                </h3>
                <p class="mt-4 text-foreground-secondary ase-justify">
                    The advanced approach is the <b>ASE</b> Task Mode.
                    The pro is that its plans can easily co-exist and
                    be edited in parallel, the con is its weakness
                    because crafting / resolution / refactoring tenets are
                    not internalized by the LLM and hence cannot guide
                    the operation. Use for complex tasks under explicit
                    planning.
                </p>
            </div>
            <div class="lg:order-2 relative isolate" data-reveal="left">
                <Terminal
                    prefix="Claude Code"
                    helpPage={Astro.url.pathname}
                    commands={[
                        "**/ase-task-edit** Create \"hello\" CLI command which prints \"Hello World\" in red to the terminal",
                        "Change output color to blue",
                        "Use NPM package \"chalk\" for coloring",
                        "**IMPLEMENT (dialog selection)**",
                        "**DELETE (dialog selection)**"
                    ]}
                />
            </div>
        </div>

        <div class="ase-grid-split">
            <div class="lg:order-1 relative isolate" data-reveal="right">
                <p class="ase-eyebrow">Task Mode #2</p>
                <h3 class="ase-h3 flex items-center gap-2">
                    <PlaneTakeoff class="h-6 w-6 shrink-0 sm:h-7 sm:w-7" stroke-width={0.75}/>
                    Professional Planning
                </h3>
                <p class="mt-4 text-foreground-secondary ase-justify">
                    The professional approach is the <b>ASE</b> Task
                    Mode, based on various <b>ASE</b> task skills
                    for grilling the plan and drafting its implementation.
                    The pro is that the plan becomes more robust and the
                    result more foreseeable, the con is its necessary
                    extra steps. Use for complex tasks where extra
                    "thinking before acting" is desired.
                </p>
            </div>
            <div class="lg:order-2 relative isolate" data-reveal="left">
                <GlowSide variant="text" side="right"/>
                <Terminal
                    prefix="Claude Code"
                    helpPage={Astro.url.pathname}
                    commands={[
