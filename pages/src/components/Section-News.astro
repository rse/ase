/*  "News" section: the releases of the top-level `NEWS.md`, each with its
    optional USP rows, and its features and its incompatibilities as identical
    three-column grids of plates, where only the warning icon of the heading
    marks the latter. The plates are left-aligned, as justifying their many
    code chips leaves gaps.  */

import Sparkles           from "@lucide/astro/icons/sparkles"
import TriangleAlert      from "@lucide/astro/icons/triangle-exclamation-point"
import GlowSide           from "./Widget-Glow-Side.astro"
import Annotation         from "./Widget-Annotation.astro"
import USPRow             from "./Widget-USP-Row.astro"
import { site }           from "../data/site.ts"
import { newsReleases }   from "../data/news.ts"
import { usps, type USP } from "../data/usps.ts"

/*  the USPs showcased between the introduction and the sections of a release  */
const releaseUSPs: Record<string, USP[]> = {
    "ase-2.0": usps.slice(0, 4)
}
---
<section id="news" class="mt-4 sm:mt-12 relative isolate mx-auto max-w-4xl px-6 py-8">
    <GlowSide variant="section" side="right" />
    <header class="ase-section-head" data-reveal>
        <h2 class="ase-h2 relative inline-block">
            <Annotation flat class="hidden sm:block right-0 translate-x-2/3">
                Upgrading?<br/>
                Check features and<br/>
                incompatibilities!
            </Annotation>
            What is <span class="text-accent">New</span> in ASE
        </h2>
        <p class="ase-lead ase-justify">
            The notable changes between the major releases of <b>ASE</b>:
            the new <b>features</b> you can leverage, and the <b>incompatibilities</b>{" "}
            you have to take into account when upgrading. The same information is
            available as the <a href={`${site.repo}/blob/master/NEWS.md`}>NEWS.md</a>{" "}
            file of the project repository.
        </p>
    </header>

    {newsReleases.map((release) => (
        <div id={release.id} class="mt-12 scroll-mt-20">
            <h3 class="ase-h3 text-center" data-reveal>{release.title}</h3>
            {release.intro.length > 0 ?
                <div class="news-intro ase-lead mx-auto mt-5 max-w-2xl md:columns-2 md:gap-8" data-reveal>
                    {release.intro.map((html, i) => (
                        <p class={i === 0 ? "ase-justify" : "ase-indent-p ase-justify"} set:html={html}/>
                    ))}
                </div> :
                null}
            {(releaseUSPs[release.id] ?? []).length > 0 ?
                <div class="mt-12 flex flex-col gap-16">
                    {releaseUSPs[release.id].map((usp, index) => <USPRow usp={usp} index={index}/>)}
                </div> :
                null}
            {release.sections.map((section) => (
                <div class="mt-10 [h3+&]:mt-5" data-reveal>
                    <div class="flex items-center justify-center gap-2 text-white">
                        {section.kind === "incompatibilities" ?
                            <TriangleAlert class="h-6 w-6 shrink-0" stroke-width={1.25}/> :
                            <Sparkles class="h-6 w-6 shrink-0" stroke-width={1.25}/>}
                        <h4 class="text-lg font-semibold uppercase tracking-wider">{section.label}</h4>
                        <span class="rounded-full border border-white/40 px-2 text-sm">{section.items.length}</span>
                    </div>
                    <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
                        {section.items.map((item) => (
                            <div class="news-item rounded-xl border border-border-strong bg-accent/10 px-3 py-2 transition hover:border-accent">
                                {item.title !== "" && <div class="font-bold text-accent">{item.title}</div>}
                                <div class="mt-1 text-[0.8125rem] leading-[1.3] text-foreground-secondary" set:html={item.html}/>
                            </div>
                        ))}
                    </div>
                </div>
            ))}
        </div>
    ))}
</section>

<style>
    /*  keep the inline code chips of the news items from overflowing the
        narrow plates, as the option and file names can get rather long  */
    .news-item :global(code) {
        overflow-wrap: anywhere;
    }

    /*  lift the inline code chips of the news texts (but not of the
        terminals of the USPs) off their backgrounds for better visibility  */
    .news-intro :global(code),
    .news-item  :global(code) {
        border-color: var(--border-strong);
        background: color-mix(in oklch, var(--foreground) 15%, transparent);
    }
</style>
