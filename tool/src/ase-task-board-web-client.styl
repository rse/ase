/*  emit standard CSS at-rules only (no legacy vendor prefixes)  */
vendors = official

/*  Adobe Source Sans 3 font faces (inlined by Vite as data: URIs), where
    the semi-bold faces also serve "bold" (weight range up to 700)  */
@font-face
    font-family: "Source Sans 3"
    font-style: normal
    font-weight: normal
    src: url("../node_modules/source-sans/WOFF2/TTF/SourceSans3-Regular.ttf.woff2") format("woff2")
@font-face
    font-family: "Source Sans 3"
    font-style: italic
    font-weight: normal
    src: url("../node_modules/source-sans/WOFF2/TTF/SourceSans3-It.ttf.woff2") format("woff2")
@font-face
    font-family: "Source Sans 3"
    font-style: normal
    font-weight: 600 700
    src: url("../node_modules/source-sans/WOFF2/TTF/SourceSans3-Semibold.ttf.woff2") format("woff2")
@font-face
    font-family: "Source Sans 3"
    font-style: italic
    font-weight: 600 700
    src: url("../node_modules/source-sans/WOFF2/TTF/SourceSans3-SemiboldIt.ttf.woff2") format("woff2")

/*  DejaVu Sans Mono font faces for code (regular and bold only, as the
    oblique faces are intentionally not embedded)  */
@font-face
    font-family: "DejaVu Sans Mono"
    font-style: normal
    font-weight: normal
    src: url("../node_modules/@fontsource/dejavu-mono/files/dejavu-mono-latin-400-normal.woff2") format("woff2")
@font-face
    font-family: "DejaVu Sans Mono"
    font-style: normal
    font-weight: bold
    src: url("../node_modules/@fontsource/dejavu-mono/files/dejavu-mono-latin-700-normal.woff2") format("woff2")

/*  the semantic colors (layer 2), mapped onto the color spreads
    "--color-<role>-{1..64}" (layer 1) of the colors stylesheet  */
:root
    --c-text:          var(--color-normal-21)
    --c-text-strong:   var(--color-normal-25)
    --c-text-soft:     var(--color-normal-29)
    --c-paper:         var(--color-normal-64)
    --c-shade:         var(--color-normal-13)
    --c-mute:          var(--color-dim-35)
    --c-line:          var(--color-dim-44)
    --c-border-strong: var(--color-dim-52)
    --c-border:        var(--color-dim-54)
    --c-border-soft:   var(--color-dim-56)
    --c-fill:          var(--color-dim-60)
    --c-ground:        var(--color-dim-62)
    --c-ground-light:  var(--color-dim-63)
    --c-accent-strong: var(--color-accent-27)
    --c-accent:        var(--color-accent-36)
    --c-accent-light:  var(--color-accent-44)
    --c-accent-line:   var(--color-accent-52)
    --c-accent-border: var(--color-accent-54)
    --c-accent-fill:   var(--color-accent-60)
    --c-accent-ground: var(--color-accent-62)
    --c-accent-paper:  var(--color-accent-64)
    --c-signal-strong: var(--color-signal-27)
    --c-signal:        var(--color-signal-42)
    --c-signal-ground: var(--color-signal-62)

/*  the base settings  */
*
    box-sizing: border-box
[hidden]
    display: none !important

/*  the single fixed font size, from which all other font sizes derive (in rem units)  */
html, body
    font-size: 16px
body
    margin: 0
    font-family: "Source Sans 3", Helvetica, Arial, sans-serif
    line-height: 1.3
    color: var(--c-text)
    background: var(--c-ground)

/*  the page as a column of exactly the viewport height, where the view takes all
    the height left by the header and the footer, so the footer always ends at the bottom edge  */
#app
    display: flex
    flex-direction: column
    height: 100vh
.spacer
    flex: 1
.mute
    color: var(--c-mute)
    font-size: 0.6875rem
.warn
    color: var(--c-signal)
    font-size: 0.6875rem

/*  the header  */
header
    display: flex
    align-items: center
    justify-content: center
    flex-wrap: wrap
    gap: 4px 16px
    margin: 0 16px
    padding: 7px 16px
    background: var(--c-paper)

    /*  the line below the header, turning upward with rounded corners at both ends  */
    border: 1px solid var(--c-border-soft)
    border-top: 0
    border-radius: 0 0 8px 8px
    position: sticky
    top: 0
    z-index: 5
    color: var(--c-text-soft)

    /*  the separators between the header elements  */
    .sep
        margin: 0 0.6rem
        color: var(--c-mute)

    /*  the application name and the read-only header values, emphasized but without a box  */
    .emph
        color: var(--c-text)
        font-weight: bold

    /*  the header values in boxes, with the view as a toggle button  */
    .val
        display: inline-block
        margin-left: 0.2rem
        padding: 0 6px
        border: 1px solid var(--c-border)
        border-radius: 4px
        background: var(--c-ground-light)
        color: var(--c-text)
        font: inherit
        font-weight: bold
    .toggle
        cursor: pointer
        &:hover
            border-color: var(--c-signal)
            background: var(--c-signal-ground)
            color: var(--c-signal-strong)

    /*  the view value with the fixed width of the longest view name, by stacking
        all view names into the same grid cell, with only the current one visible  */
    .view
        display: inline-grid
        justify-items: center
        > span
            grid-area: 1 / 1
            &.off
                visibility: hidden

    /*  the filter input field at the end of the header, with its clear
        button placed inside the field on its right side  */
    .filter
        display: inline-flex
        align-items: center
        gap: 4px
        .field
            position: relative
            display: inline-flex
            align-items: center
        input
            width: 180px
            padding-right: 22px
            outline: none
            &:hover, &:focus
                border-color: var(--c-signal)
                background: var(--c-signal-ground)
                color: var(--c-signal-strong)
        .clear
            position: absolute
            right: 4px
            padding: 0 2px
            border: none
            background: none
            color: var(--c-mute)
            font: inherit
            font-size: 80%
            line-height: 1
            cursor: pointer
            &:hover
                color: var(--c-signal)

        /*  the disabled filter field of the agents view (which is not filtered), dimmed  */
        &.off
            opacity: 0.4
            input
                cursor: default
                &:hover
                    border-color: var(--c-border)
                    background: var(--c-ground-light)
                    color: var(--c-text)

/*  the lanes view  */
#view
    flex: 1
    min-height: 0
    display: flex
    flex-direction: column
    padding: 14px 16px 4px
#board
    display: flex
    gap: 12px
    flex: 1
    min-height: 0
    overflow-x: auto

    /*  a double click opens or toggles, so it must not select text  */
    user-select: none
.group
    display: flex
    flex-direction: column
    gap: 8px
    min-width: 220px
    flex: 1
    &.coll
        min-width: 36px
        max-width: 36px
        flex: none
        .ghd
            padding: 4px 0

        /*  the lanes of a collapsed group as narrow boxes: arrow on top,
            vertically written status, and number of cards at the bottom  */
        .lane
            align-items: center
            gap: 6px
            overflow: hidden

            /*  the top and bottom spacing sits on the arrow and the count, as a
                padding of the lane itself would raise its minimum height and so
                make the weighted lane heights differ from the ones of expanded groups  */
            > .arr
                margin-top: 6px
            > .cnt
                margin-bottom: 6px
            cursor: pointer
            font-weight: bold
            font-size: 0.875rem
            background: var(--c-fill)
            color: var(--c-text-soft)
            &.active
                background: var(--c-accent-fill)
                color: var(--c-accent-strong)
            &.done
                color: var(--c-line)
        .vt
            flex: 1
            min-height: 0
            overflow: hidden
            writing-mode: vertical-rl
            text-orientation: upright

            /*  tighten the vertical step between the stacked upright letters
                (for vertical text, "line-height" only sets the column width)  */
            letter-spacing: -0.25em
        .cnt
            font-weight: normal
.ghd
    background: var(--c-text-strong)
    color: var(--c-paper)
    font-weight: bold
    font-size: 0.875rem
    padding: 4px 12px
    border-radius: 6px
    cursor: pointer
    white-space: nowrap
    text-align: center

/*  the group and lane titles after the expand/collapse arrow  */
.ttl
    margin-left: 0.5rem

/*  the expand/collapse arrow, pointing right (by rotating the same
    glyph) when collapsed, to keep both arrows exactly equally sized  */
.arr
    display: inline-block
    &.right
        transform: rotate(-90deg)
.lane
    display: flex
    flex-direction: column
    min-height: 0
    background: var(--c-ground-light)
    border: 1px solid var(--c-border)
    border-radius: 6px
    &.active
        background: var(--c-accent-ground)
        border-color: var(--c-accent-line)
    &.dashed
        border-style: dashed
    &.min
        flex: none !important
.lhd
    display: flex
    justify-content: space-between
    padding: 4px 12px
    background: var(--c-fill)
    border-radius: 6px 6px 0 0
    font-weight: bold
    color: var(--c-text-soft)
    cursor: pointer
    font-size: 0.875rem
    .active &
        background: var(--c-accent-fill)
        color: var(--c-accent-strong)

    /*  the lanes of the "done" states with dimmed names  */
    .done &
        color: var(--c-line)
.lane, .cards
    outline: none
/*  the cards of a lane, keeping their padding also when scrolling
    the selected task box into view (e.g. via the cursor keys)  */
.cards
    overflow-y: auto
    padding: 8px 10px
    scroll-padding-block: 8px
    display: flex
    flex-direction: column
    gap: 8px

/*  the grown lane: all other groups and lanes (and the group header) hidden, and
    the cards in a grid of at least four columns, or more if the cards then still
    keep their minimum width, with all cards of a row having the same height  */
#board.grown
    overflow-x: hidden
    .group:not(.grown), .group.grown > .ghd, .group.grown > .lane:not(.grown)
        display: none
    .lane.grown
        flex: 1 1 0 !important
        .cards
            display: grid
            grid-template-columns: repeat(auto-fill, minmax(unquote("min(240px, calc((100% - 3 * 8px) / 4))"), 1fr))
            align-content: start

/*  the task boxes (of both the lanes and the graph view), with the task id in a
    sub-box, and the title cut onto a single line or (with titles shown) three lines  */
.card
    background: var(--c-paper)
    border: 1px solid var(--c-border)
    border-radius: 5px
    padding: 8px 10px
    cursor: pointer
    overflow: hidden

    /*  never shrink within a too low lane, as the lane scrolls instead  */
    flex-shrink: 0
    &:hover
        border-color: var(--c-accent)
.cbody
    white-space: nowrap
    overflow: hidden
    text-overflow: ellipsis
    .titles &
        white-space: normal
        display: -webkit-box
        -webkit-box-orient: vertical
        -webkit-line-clamp: 3
        line-clamp: 3

    /*  the inline code of the task title, in the code font  */
    code
        font-family: "DejaVu Sans Mono", Menlo, monospace
        font-size: 0.9em
        letter-spacing: -0.015em
.cid, .ref
    display: inline-block
    background: var(--c-text)
    color: var(--c-paper)
    font-weight: bold
    border-radius: 3px
    padding: 0 8px
    margin-right: 6px

/*  the task group in front of the task id of a group member: bold text in the box color  */
.cepic
    margin-right: 6px
    font-weight: bold

/*  the markers of the edit requests and the effort size of the task: bold, in the regular
    text color, framed by a thin border (like the brackets of the TUI) drawn as an inset shadow, so that it takes no
    extra height and keeps the same box height as the task id, spaced apart from the title  */
.cedit, .ceffort
    display: inline-block
    font-weight: bold
    box-shadow: inset 0 0 0 1px currentColor
    border-radius: 3px
    padding: 0 4px
    margin-right: 6px

/*  the task box with badges: room above it and on its top for the badges placed
    onto the left part of its top border (like in the TUI), also when scrolling it
    into view, where the fixed-size graph nodes always have the room on their top
    (shared with their bottom while without badges) and keep their height  */
.card.badged
    position: relative
    overflow: visible
    margin-top: 6px
    padding-top: 16px
    scroll-margin-top: 12px
#board .card.held.badged
    padding-top: 14px
    .cagents
        left: 8px
#graph .card
    padding-block: 12px
    &.badged
        margin-top: 0
        padding-top: 16px
        padding-bottom: 8px

/*  the badges of the task (the agents busy with it, else its assignee), onto the left
    part of the top border of its box (leaving room on the right part for the pulse of the box),
    aligned with the left column of the task id (i.e., the left padding of the box)  */
.cagents
    position: absolute
    top: 0
    left: 10px
    transform: translateY(-50%)
    max-width: calc(100% - 40px)
    font-weight: bold
    white-space: nowrap
    overflow: hidden
    text-overflow: ellipsis

/*  a badge of the task: its icon and name in an inverse box with rounded corners,
    in signal color when selected, in accent color when active, and else in normal color  */
.cagent
    display: inline-block
    background: var(--c-text)
    color: var(--c-paper)
    border-radius: 3px
    padding: 0 8px
    margin-right: 4px
    &:last-child
        margin-right: 0
    .aicon
        margin-right: 4px
.tone-done.card, .tone-done .card
    background: var(--c-ground)
    color: var(--c-line)
.tone-done .cid
    background: var(--c-line)
.tone-active.card, .tone-active .card
    background: var(--c-accent-paper)
    border-color: var(--c-accent-border)
    color: var(--c-accent-strong)
.tone-active.card:hover, .tone-active:hover .card
    border-color: var(--c-accent)
.tone-active .cid, .tone-active .cagent
    background: var(--c-accent)

/*  the pulse of the task boxes of active lanes, of the active graph nodes, and of the agent cards
    of the busy agents (like in the TUI), drawn as a ring centered onto their top border line (instead
    of glyphs, whose font bearings would leave gaps in the line), with a dot of pulsing size,
    in a lighter accent color (or in signal color when selected), stopped on reduced motion,
    where the agent card of a waiting agent shows just the ring (in its border color)  */
#board .lane.active .card:not(.ghost):not(.carried), #graph .node.tone-active:not(.context) .card, #agents .acard, #flow .acard
    position: relative
    overflow: visible
    &::after
        --pulse: var(--c-accent-light)
        display: block
        position: absolute
        top: -0.5px
        right: 12px
        transform: translateY(-50%)
        width: 8px
        height: 8px
        border: 1.25px solid var(--pulse)
        border-radius: 50%
        background: var(--pulse)
        content: ""
        animation: pulse 2.5s step-end infinite
#board .lane.active .card.sel:not(.ghost):not(.carried)::after, #graph .node.tone-active.sel:not(.context) .card::after, #agents .acard.sel::after, #flow .acard.sel::after
    --pulse: var(--c-signal)
#agents .acard:not(.busy)::after, #flow .acard:not(.busy)::after
    animation: none
    background: var(--c-paper)
#agents .acard:not(.busy):not(.sel)::after, #flow .acard:not(.busy):not(.sel)::after
    --pulse: var(--c-border-strong)

/*  the frames of the pulse (like "pulseFrames" of the TUI: "●", "◉", "⦿", "○", "⦿", "◉"):
    10 frames of 250ms, staying on the filled circle for the first half  */
@keyframes pulse
    0%
        background: var(--pulse)
    50%
        background: radial-gradient(circle closest-side, var(--pulse) 60%, var(--c-accent-paper) 60%)
    60%
        background: radial-gradient(circle closest-side, var(--pulse) 30%, var(--c-accent-paper) 30%)
    70%
        background: var(--c-accent-paper)
    80%
        background: radial-gradient(circle closest-side, var(--pulse) 30%, var(--c-accent-paper) 30%)
    90%
        background: radial-gradient(circle closest-side, var(--pulse) 60%, var(--c-accent-paper) 60%)
@media (prefers-reduced-motion: reduce)
    #board .lane.active .card:not(.ghost):not(.carried)::after, #graph .node.tone-active:not(.context) .card::after, #agents .acard::after, #flow .acard::after
        animation: none
    #busy .spinner, #busy .bar .block
        animation: none

/*  the drag & drop of task boxes: the dragged task box, the lanes it can be
    dropped onto (filled while hovered), and the lanes it cannot be dropped onto
    (with the lanes view id raising the specificity above the lane grounds)  */
#board
    .card.dragging
        opacity: 0.4
    .lane.target
        border-color: var(--c-accent)
        border-style: dashed
    .lane.over
        background: var(--c-accent-fill)
    .lane.blocked
        opacity: 0.45

/*  the keyboard selection (like in the TUI): the selected group header, the
    selected lane (with a bold border), and the selected task box, all in signal color  */
#board
    .ghd.sel
        background: var(--c-signal)
    .lane.sel
        border-color: var(--c-signal)
        box-shadow: 0 0 0 1px var(--c-signal)
#board .card.sel, #graph .node.sel .card
    border-color: var(--c-signal)
    box-shadow: 0 0 0 1px var(--c-signal)
    color: var(--c-signal)
#board .card.sel .cid, #graph .node.sel .cid, #board .card.sel .cagent, #graph .node.sel .cagent
    background: var(--c-signal)

/*  the task carried by the keyboard (like in the TUI): held with a double border,
    and while shown on a target lane, a dim dashed ghost at its origin  */
#board .card.held
    border-style: double
    border-width: 3px
    padding: 6px 8px
#board .card.ghost
    background: none
    border-style: dashed
    border-color: var(--c-line)
    box-shadow: none
    color: var(--c-line)
    .cid
        background: var(--c-line)

/*  the horizontal scroll bar and the footer  */
#hscroll
    display: flex
    align-items: center
    justify-content: center
    gap: 8px
    padding: 0 16px
    color: var(--c-mute)
    font-size: 0.8125rem
    button
        border: 0
        background: none
        cursor: pointer
        color: var(--c-text-soft)

    /*  the separator between the visible groups and the scroll hint  */
    .sep
        margin: 0 0.6rem
        color: var(--c-mute)

    /*  the hint to show the hidden key hints again, separated only from a preceding info
        (and then joined to it, without the gap of the flex layout)  */
    .keys
        white-space: nowrap
        kbd
            margin-right: 0.4rem
    span + .keys
        margin-left: -8px
    button + .keys > .sep
        display: none

/*  the agents view: the framed master list of the agent cards (selected one in signal color,
    busy ones in accent color, and waiting ones in normal color),
    and the framed detail view with the agent log, whose lines are broken with a hanging indent
    behind their timestamp prefix (in normal color), followed by their task id and level prefix,
    with their level and content in accent color (resp. signal color for warnings and errors)  */
#agents
    flex: 1
    min-height: 0
    display: flex
    gap: 12px
    section
        position: relative
        display: flex
        flex-direction: column
        min-height: 0
        border: 1px solid var(--c-border)
        border-radius: 8px
        background: var(--c-ground-light)
        padding: 14px 10px 10px
    .atitle
        position: absolute
        top: 0
        left: 50%
        transform: translate(-50%, -50%)
        max-width: calc(100% - 24px)
        white-space: nowrap
        overflow: hidden
        text-overflow: ellipsis
        padding: 0 6px
        border: 1px solid var(--c-border)
        border-radius: 5px
        background: var(--c-paper)
        color: var(--c-mute)
        font-size: 0.8125rem
        font-weight: bold
    /*  the position within the agent log, on the bottom border of its detail view  */
    .apos
        position: absolute
        bottom: 0
        right: 12px
        transform: translate(0, 50%)
        white-space: nowrap
        padding: 0 6px
        border: 1px solid var(--c-border)
        border-radius: 5px
        background: var(--c-paper)
        color: var(--c-mute)
        font-size: 0.8125rem
    .amaster
        flex: 0 0 260px

    /*  the right side: the pane of the operation and the three equally wide panes of the selected agent above its log  */
    .aright
        flex: 1
        min-width: 0
        display: flex
        flex-direction: column
        gap: 16px
        section
            padding-left: 16px
            padding-right: 16px
    .ainfos
        flex-shrink: 0
        display: grid
        grid-template-columns: repeat(2, minmax(0, 1fr))
        gap: 12px
        .afields
            font-size: 1rem
            line-height: 1.15

        /*  colored like the active lanes (and like the averages and the efficiency
            of the statistics view), with the title like their lane header  */
        section.ainfo
            border-color: var(--c-accent-line)
            background: var(--c-accent-ground)
            color: var(--c-accent-strong)
            .atitle
                border-color: var(--c-accent-line)
                background: var(--c-accent-fill)
                color: var(--c-accent-strong)

    /*  the pane of the operation of the selected agent (above the three panes): its
        name (inverse, like on its card) and its title in bold (cut with an ellipsis)
        above its description, clamped to six lines of the latter  */
    .aop
        flex-shrink: 0
    .aoptext
        display: flex
        flex-direction: column
        gap: 2px
        font-size: 1rem
        line-height: 1.3
    .aophead
        display: flex
        align-items: baseline
        gap: 8px
        min-width: 0
        .abadge
            flex-shrink: 0
            white-space: nowrap
        b, .aempty
            min-width: 0
            white-space: nowrap
            overflow: hidden
            text-overflow: ellipsis
    .aopdesc
        display: -webkit-box
        -webkit-box-orient: vertical
        -webkit-line-clamp: 6
        line-clamp: 6
        overflow: hidden
    .adetail
        flex: 1
        min-width: 0
        min-height: 0
    .alist
        flex: 1
        min-height: 0
        overflow-y: auto
        /*  make room for the pulse ring on the top border of the first card,
            which the scroll container would otherwise clip  */
        margin-top: -6px
        padding-top: 6px
        display: flex
        flex-direction: column
        gap: 8px
    .aempty
        color: var(--c-mute)
        font-size: 0.8125rem
        &.off
            color: var(--c-signal)

/*  the agent cards (of the agents view and of the agent graph) and the agent log  */
#agents, #flow
    .acard
        flex-shrink: 0
        padding: 6px 10px
        border: 1px solid var(--c-border)
        border-radius: 5px
        background: var(--c-paper)
        cursor: pointer
        &:hover
            border-color: var(--c-accent)
        &.busy
            background: var(--c-accent-ground)
            border-color: var(--c-accent)
            color: var(--c-accent)
        &.sel
            border: 2px solid var(--c-signal)
            padding: 5px 9px
            .aname, .afields
                color: var(--c-signal)
        &.busy.sel
            background: var(--c-signal-ground)
    .aname
        margin-bottom: 3px
        padding-right: 1.4em
        font-weight: bold
        white-space: nowrap
        overflow: hidden
        text-overflow: ellipsis

    /*  the heart of the agent (filled for a second after each received heartbeat, else
        empty) in the top right corner inside the card, in the color of its card, and in
        the embedded DejaVu Sans Mono (which carries both hearts in a consistent size,
        whereas the text font would let the browser pick them from differing fallbacks),
        centered within a box of the same right offset and outer width as the pulse ring
        on the top border (8px plus twice its 1.25px border), so both are vertically aligned  */
    .abeat
        position: absolute
        top: 6px
        right: 12px
        width: 10.5px
        text-align: center
        font-family: "DejaVu Sans Mono", monospace
        color: var(--c-text)
    .acard.busy .abeat
        color: var(--c-accent)
    .acard.sel .abeat
        top: 5px
        color: var(--c-signal)

    /*  the agent name with its icon (spaced apart a bit more): inverse in the color of its card  */
    .abadge
        padding: 0 9px
        border-radius: 3px
        color: var(--c-paper)
        background: var(--c-text)
    .aicon
        margin-right: 4px
    .acard.busy .abadge
        background: var(--c-accent)
    .acard.sel .abadge
        background: var(--c-signal)

    /*  the fields of the agent card as a two-column grid, aligning the
        values behind their labels of the same width (the widest one)  */
    .afields
        display: grid
        grid-template-columns: max-content minmax(0, 1fr)
        align-items: baseline
        column-gap: 0.4em
        font-size: 0.875rem
        line-height: 1.05
    .aval
        white-space: nowrap
        overflow: hidden
        text-overflow: ellipsis

    /*  a value cut at its start (with its text itself isolated left-to-right)  */
    .aval.astart
        direction: rtl
        text-align: left

    /*  the task ids with the task icon (on the agent cards and in the agent log): inverse in
        the color of their card (resp. their log line), like the ids on the task cards, and on
        the agent cards with a line height of their own, as the tight one of the fields
        would let the glyphs exceed their box  */
    .atasks
        display: flex
        flex-wrap: wrap
        gap: 4px
        .atask
            line-height: 1.25
    .atask
        display: inline-block
        padding: 0 4px
        border-radius: 3px
        font-weight: bold
        color: var(--c-paper)
        background: var(--c-text)
    .acard.busy .atask
        background: var(--c-accent)
    .acard.sel .atask
        background: var(--c-signal)
    .aline .atask
        text-indent: 0
        line-height: 1.10
        background: var(--c-accent)
    .aline.warning .atask, .aline.error .atask
        background: var(--c-signal)
    .alog
        flex: 1
        min-height: 0
        overflow-y: auto
    .aline

        /*  hang the wrapped lines behind the 25 characters of the timestamp prefix
            (the "ch" unit does not include the letter spacing)  */
        padding-left: calc(25ch - 25 * 0.015em)
        text-indent: calc(-25ch + 25 * 0.015em)
        font-family: "DejaVu Sans Mono", Menlo, monospace
        font-size: 0.8125rem
        letter-spacing: -0.015em
        line-height: 1.2
        white-space: pre-wrap
        overflow-wrap: anywhere
        color: var(--c-accent)
        .atime
            color: var(--c-text)
        &.warning, &.error
            color: var(--c-signal)

/*  the statistics view (like the agents view, with framed sections): the column chart of the
    tasks per state (in the dark colors of their lanes, like in the TUI, with the efforts and phases below
    the states), the stacked bar of the progress of the tasks (the cancelled tasks
    dim and hatched, the finished ones dark, the work-in-progress ones in accent color, and the
    open ones light), and the bars of the total usage (the AI and human amounts in accent color,
    the real times dim, and the stacked token counts in the shades of the accent color, with the
    compact column chart of the distribution of the effort sizes besides them), below
    the centered buttons of the time ranges, separated by dots (the one of the shown time range
    in signal color)  */
#stats
    flex: 1
    min-height: 0
    display: flex
    flex-direction: column
    gap: 16px
    padding-top: 8px
    overflow-y: auto
    section
        position: relative
        border: 1px solid var(--c-border)
        border-radius: 8px
        background: var(--c-ground-light)
        padding: 16px 12px 10px
    .stitle
        @extend #agents .atitle
    .sranges
        display: flex
        justify-content: center
        align-items: center
        gap: 0.6rem
        button
            border: 1px solid var(--c-border)
            border-radius: 4px
            padding: 2px 12px
            background: var(--c-ground-light)
            color: var(--c-text)
            font: inherit
            font-size: 0.8125rem
            font-weight: bold
            cursor: pointer
            &:hover
                border-color: var(--c-signal)
                background: var(--c-signal-ground)
                color: var(--c-signal-strong)
            &.on
                border-color: var(--c-signal)
                background: var(--c-signal)
                color: var(--c-paper)
    .sempty
        color: var(--c-mute)
        font-size: 0.8125rem
        &.off
            color: var(--c-signal)

    /*  the row of the column charts, taking the remaining height  */
    .scharts
        flex: 1
        min-height: 200px

    /*  the column chart, where each column leaves room for its number on top of it  */
    .schart
        min-height: 0
        display: flex
        flex-direction: column
    .sgrid
        flex: 1
        min-height: 0
        display: grid
        grid-template-rows: minmax(0, 1fr) auto auto auto auto
        column-gap: 6px
        /*  the compact column chart (like the effort distribution), without the
            sub-labels and the groups, filling the height of its row  */
        &.scompact
            grid-template-rows: minmax(0, 1fr) auto auto
    .scol
        display: flex
        flex-direction: column
        justify-content: flex-end
        align-items: center
        min-height: 0
        .scount
            font-size: 0.8125rem
            line-height: 1.5
            font-weight: bold
            color: var(--c-text-soft)
        .sbar
            width: 100%
            border: 1px solid var(--c-text)
            border-bottom: 0
            border-radius: 3px 3px 0 0
            background: var(--c-text)
        &.active
            .scount
                color: var(--c-accent-strong)
            .sbar
                border-color: var(--c-accent)
                background: var(--c-accent)
        &.done
            .scount
                color: var(--c-line)
            .sbar
                border-color: var(--c-mute)
                background: var(--c-mute)
    /*  the labels of the columns, cut to their first seven characters (by the
        component), and without an ellipsis if still too long, for readability  */
    .sstate
        padding-top: 4px
        border-top: 1px solid var(--c-border)
        text-align: center
        white-space: nowrap
        overflow: hidden
        text-overflow: clip
        font-size: 0.75rem
        font-weight: bold
        color: var(--c-text-soft)
        &.active
            color: var(--c-accent-strong)
        &.done
            color: var(--c-line)
    /*  the sub-labels of the columns below their labels (like the effort of the estimated tasks
        of a state), keeping their height also if empty, to keep the columns of all charts aligned  */
    .seffort
        min-height: 1.5em
        line-height: 1.5
        text-align: center
        white-space: nowrap
        overflow: hidden
        text-overflow: ellipsis
        font-size: 0.75rem
        color: var(--c-text-soft)
        &.active
            color: var(--c-accent-strong)
        &.done
            color: var(--c-line)
    .sphase
        margin-top: 4px
        padding-top: 2px
        border-top: 1px solid var(--c-border-soft)
        text-align: center
        white-space: nowrap
        overflow: hidden
        text-overflow: ellipsis
        font-size: 0.75rem
        color: var(--c-mute)
    /*  the footer of the column chart (blank if empty, to keep the
        columns of all charts aligned), like the forecast of the backlog  */
    .sfoot
        padding-top: 2px
        text-align: center
        white-space: nowrap
        overflow: hidden
        text-overflow: ellipsis
        font-size: 0.75rem
        color: var(--c-mute)

    /*  the stacked bar of the progress, with its legend  */
    .sstack
        display: flex
        height: 22px
        border: 1px solid var(--c-border)
        border-radius: 5px
        overflow: hidden
        background: var(--c-paper)
    .spart
        flex-basis: 0
        min-width: 2px
    .slegend
        display: flex
        flex-wrap: wrap
        gap: 4px 16px
        margin-top: 6px
        font-size: 0.8125rem
        color: var(--c-text-soft)
    .sprogress .slegend
        justify-content: center
        column-gap: 0.6rem

    /*  the separators between the entries of the progress legend (like in the TUI)  */
    .ssep
        color: var(--c-mute)
    .sswatch
        display: inline-block
        width: 10px
        height: 10px
        margin-right: 5px
        border-radius: 2px
    .spart, .sswatch
        &.finished
            background: var(--c-text)
        &.cancelled
            background: repeating-linear-gradient(45deg, var(--c-border-strong) 0 3px, var(--c-ground) 3px 6px)
        &.wip
            background: var(--c-accent)
        &.open, &.ready
            background: var(--c-fill)
        &.blocked
            background: repeating-linear-gradient(45deg, var(--c-signal) 0 3px, var(--c-signal-ground) 3px 6px)

    /*  the rows with two framed sections, the left one taking two thirds (like in the TUI)  */
    .spair
        display: grid
        grid-template-columns: minmax(0, 2fr) minmax(0, 1fr)
        gap: 16px

    /*  the right third of a row split into two framed sections side by side  */
    .ssplit
        display: grid
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr)
        gap: 16px

    /*  the table of the tasks of the highest usage: the id (inverse behind "≡", in the color
        of its lane), the title (taking the remaining width, cut with an ellipsis), the bar
        of the total share, the costs, and the input and output tokens (with the "▷" between
        them vertically aligned)  */
    .stoplist
        width: 100%
        border-collapse: collapse
        font-size: 0.8125rem
        th
            padding: 0 16px 4px 0
            text-align: left
            white-space: nowrap
            font-weight: bold
            color: var(--c-text)
        td
            padding: 2px 16px 2px 0
            white-space: nowrap
            color: var(--c-text-soft)

        /*  the rows of a fixed height, so the blank rows for the missing tasks
            keep the height of the table (like in the TUI)  */
        tbody tr
            height: 22px
        .sblank td
            color: var(--c-mute)
        th:last-child, td:last-child
            padding-right: 0
        .cid
            margin-right: 0
            &.active
                background: var(--c-accent)
            &.done
                background: var(--c-line)
        .stask
            width: 100%
            max-width: 0
            overflow: hidden
            text-overflow: ellipsis
        .sbarcell
            width: 16%
            min-width: 60px
        .snum
            text-align: right
            font-variant-numeric: tabular-nums
        td.snum
            font-weight: bold
            color: var(--c-text)
        .stok
            display: inline-block
            text-align: right
        .sflow
            margin: 0 0.4em
            font-weight: normal
            color: var(--c-mute)

    /*  the averages per finished task and the efficiency of the AI usage, colored like the
        active lanes (with the title like their lane header): labels with their values
        right-aligned, where a too long label is cut with an ellipsis  */
    section.seffect
        display: flex
        flex-direction: column
        gap: 2px
        line-height: 1.15
        border-color: var(--c-accent-line)
        background: var(--c-accent-ground)
        color: var(--c-accent-strong)
        .stitle
            border-color: var(--c-accent-line)
            background: var(--c-accent-fill)
            color: var(--c-accent-strong)
        .sline b
            color: var(--c-accent-strong)
        .sline .sflow
            color: var(--c-accent-light)
    .sline
        display: flex
        justify-content: space-between
        gap: 8px
        span:first-child
            min-width: 0
            white-space: nowrap
            overflow: hidden
            text-overflow: ellipsis
        b
            white-space: nowrap
            font-variant-numeric: tabular-nums
            color: var(--c-text)
        .sflow
            margin: 0 0.4em
            font-weight: normal
            color: var(--c-mute)

    /*  the bars of the total AI usage by the times, tokens, and costs (columns)  */
    .smatrix
        display: grid
        grid-template-columns: repeat(3, minmax(0, 1fr))
        gap: 8px 14px
        align-items: start
        font-size: 0.8125rem
    .shead
        font-weight: bold
        color: var(--c-text)

    /*  the legend of the token bar below it, in two columns (cache read and
        write on the left, input and output on the right), aligned with the bar  */
    .stokens
        display: grid
        grid-template-rows: auto auto
        grid-auto-flow: column
        justify-content: start
        gap: 3px 24px
        margin: 2px 0 0 calc(2.5em + 6px)
        color: var(--c-mute)
    .scell
        display: flex
        flex-direction: column
        gap: 3px
        min-width: 0
    .srow
        display: flex
        align-items: center
        gap: 6px
    .sname
        flex: 0 0 2.5em
        color: var(--c-mute)
    .strack
        flex: 1
        min-width: 0
        height: 16px
        display: flex
        border: 1px solid var(--c-border-soft)
        border-radius: 3px
        overflow: hidden
        background: var(--c-paper)
    .sfill
        flex: none
        height: 100%
    .sval
        flex: 0 0 3.8em
        text-align: left
        font-variant-numeric: tabular-nums
        font-weight: bold
        color: var(--c-text)
    .sfill, .sswatch
        &.ai
            background: var(--c-accent)
        &.hr
            background: var(--c-accent)
        &.real
            background: var(--c-mute)
        &.cread
            background: var(--c-accent-line)
        &.cwrite
            background: var(--c-accent-light)
        &.input
            background: var(--c-accent)
        &.output
            background: var(--c-accent-strong)
footer
    padding: 4px 16px 6px
    text-align: center
    color: var(--c-text-soft)
    font-size: 0.8125rem

    /*  the key hint lines, truncated with an ellipsis instead of broken (like in the TUI)  */
    .hints
        overflow: hidden
        white-space: nowrap
        text-overflow: ellipsis

    /*  the status line in the last line, below the key hints, on the background of
        the header, with the line above it turning downward with rounded corners at
        both ends (keeping its height while empty)  */
    .status
        margin: 6px 0 -6px
        padding: 7px 16px
        font-size: 1rem
        background: var(--c-paper)
        border: 1px solid var(--c-border-soft)
        border-bottom: 0
        border-radius: 8px 8px 0 0
        min-height: 1.3em
        overflow: hidden
        white-space: nowrap
        text-overflow: ellipsis
        color: var(--c-signal)

        /*  the connection states and the ASE version, while there is nothing
            else to report, with a lost connection in signal color  */
        &.idle
            color: var(--c-mute)
            .off
                color: var(--c-signal)

    /*  the separators between the key hints  */
    .sep
        margin: 0 0.6rem
        color: var(--c-mute)

    /*  the actions after the key caps of the key hints  */
    .action
        margin-left: 0.4rem

/*  the key caps of the board footer, the info line, the dialog footer, the deletion confirmation, the transfer popup, the assign popup, and the prompt popup  */
footer kbd, #hscroll kbd, #dlg .dfoot kbd, #confirm .keys kbd, #transfer .keys kbd, #assign .keys kbd, #prompt .keys kbd
    display: inline-block
    padding: 0 5px
    border: 1px solid var(--c-border)
    border-radius: 4px
    background: var(--c-paper)
    font: inherit
    font-weight: bold

/*  the graph view (and the agent graph view): its frame, with the graph statistics overlaid onto the top-right
    corner of the graph border (like in the TUI), dimmed, in a box like the graph panel  */
#gframe, #fframe
    position: relative
    flex: 1
    min-height: 0
    display: flex
    flex-direction: column
    .gstats
        position: absolute
        top: 0
        left: 50%
        transform: translate(-50%, -50%)
        max-width: calc(100% - 24px)
        white-space: nowrap
        overflow: hidden
        text-overflow: ellipsis
        padding: 0 6px
        border: 1px solid var(--c-border-soft)
        border-radius: 5px
        background: var(--c-ground-light)
        color: var(--c-mute)
        font-size: 0.8125rem
        pointer-events: none
#graph, #flow
    flex: 1
    min-height: 0
    overflow: auto
    background: var(--c-ground-light)
    border: 1px solid var(--c-border-soft)
    border-radius: 6px
    cursor: grab

    /*  a double click opens a task (resp. an agent), so it must not select text  */
    user-select: none

    /*  a zoom-independent gap between the panel border and a larger graph (also when
        scrolled to its ends or when scrolling the selected task box into view)  */
    padding: 16px
    scroll-padding: 16px

    /*  the background is dragged for scrolling  */
    &.panning
        cursor: grabbing
        user-select: none

    /*  a graph smaller than the view is centered in it (via auto margins,
        which, unlike centering alignments, keep an overflowing graph scrollable),
        and a larger graph is never shrunk (it is zoomed explicitly only)  */
    display: flex
    svg
        max-width: none
        display: block
        flex-shrink: 0
        margin: auto

        /*  do not clip the pulses and edges on the graph bounds (the graph has no inner padding)  */
        overflow: visible
    .node
        cursor: pointer

        /*  do not clip the pulse of the task boxes of the active nodes  */
        foreignObject
            overflow: visible
    .card
        box-sizing: border-box
        height: 100%

    /*  the title within the label lines its fixed-size node has room for  */
    &.titles .card
        &[data-lines="1"] .cbody
            -webkit-line-clamp: 1
            line-clamp: 1
        &[data-lines="2"] .cbody
            -webkit-line-clamp: 2
            line-clamp: 2

    /*  the dependency context of a filtered graph: dimmed and dashed  */
    .node.context .card
        opacity: 0.5
        border-style: dashed
    .edge
        fill: none
        stroke: var(--c-line)
        stroke-width: 1.4
        &.sel
            stroke: var(--c-signal)
            stroke-width: 2.5
        &.dashed
            stroke-dasharray: 5 4
    .arrow
        fill: var(--c-line)
    .arrow-sel
        fill: var(--c-signal)

    /*  the lifecycle states of the agent graph, and its agent cards filling their fixed-size nodes  */
    .state
        rect
            fill: var(--c-paper)
            stroke: var(--c-border-strong)
            stroke-width: 1.2
        text
            fill: var(--c-mute)
            font-size: 13px
            font-weight: bold
            text-anchor: middle
            dominant-baseline: central
        &:hover rect
            stroke: var(--c-accent)
        &.sel
            rect
                stroke: var(--c-signal)
                stroke-width: 2
            text
                fill: var(--c-signal)
    .acard
        box-sizing: border-box
        height: 100%

    /*  the dashed container of the tasks of a group, with the group name in its top-left corner  */
    .cluster
        rect
            fill: none
            stroke: var(--c-line)
            stroke-width: 1.4
            stroke-dasharray: 6 4
        text
            fill: var(--c-mute)
            font-size: 13px
            font-weight: bold

/*  the arrow marker of the marked edges of the selected node, unique per drawing
    (as a marker of the hidden drawing of the other view does not render)  */
#graph .edge.sel
    marker-end: url(#graph-arrow-sel)
#flow .edge.sel
    marker-end: url(#flow-arrow-sel)

/*  the task dialog  */
#scrim
    position: fixed
    inset: 0
    background: unquote("color-mix(in srgb, var(--c-shade) 55%, transparent)")
    z-index: 10

/*  the confirmation of a task deletion, the transfer popup, the assign popup,
    the prompt popup, and the busy popup: a small box, centered over everything  */
#confirm, #transfer, #assign, #prompt, #busy
    position: fixed
    inset: 0
    display: flex
    align-items: center
    justify-content: center
    background: unquote("color-mix(in srgb, var(--c-shade) 55%, transparent)")
    z-index: 20
    .box
        display: flex
        flex-direction: column
        align-items: center
        gap: 12px
        padding: 16px 24px 10px
        background: var(--c-paper)
        border: 1px solid var(--c-signal)
        border-radius: 10px
        box-shadow: 0 8px 32px unquote("color-mix(in srgb, var(--c-shade) 18%, transparent)")
    .ask
        color: var(--c-signal)
        font-weight: bold
    .buttons
        display: flex
        gap: 8px
        button
            border: 1px solid var(--c-signal)
            border-radius: 4px
            padding: 2px 12px
            background: var(--c-paper)
            color: var(--c-signal)
            font: inherit
            cursor: pointer
            &:hover
                background: var(--c-signal)
                color: var(--c-paper)
    .keys
        color: var(--c-text-soft)
        font-size: 0.6875rem
        .sep
            margin: 0 0.6rem
            color: var(--c-mute)
        .action
            margin-left: 0.4rem

/*  the prompt popup: in accent color, with its question in normal color (but bold),
    and with a multi-line text area for the prompt, in monospace font and accent color
    on the lightest visibly tinted accent color (resp. in signal color on the lightest
    visibly tinted signal color while focused, alike its buttons while hovered), for
    a request by prompt behind the equally wide labels of the request name field (spanning
    30% of the width of the text area, and alike colored) and the text area (for
    left-aligning them, and muted while disabled for a request ignoring its prompt), with
    the drop-down of the suggested request names directly below the request name field
    (in signal color)  */
#prompt
    .box
        border-color: var(--c-accent)
    .ask
        color: var(--c-text)
        .cid
            margin-right: 0
    .fields
        display: grid
        grid-template-columns: max-content 1fr
        gap: 12px 8px
        align-items: baseline
        width: min(760px, 80vw)
        color: var(--c-text)
        label
            white-space: nowrap
        textarea
            width: 100%
            box-sizing: border-box
    .combo
        position: relative
        width: 30%
        input
            width: 100%
            box-sizing: border-box
            padding: 2px 22px 2px 6px
            border: 1px solid var(--c-accent)
            border-radius: 4px
            background: var(--c-accent-ground)
            color: var(--c-accent)
            font: inherit
            font-family: "DejaVu Sans Mono", monospace
            font-size: 0.875em
            &:focus
                outline: none
                border-color: var(--c-signal)
                background: var(--c-signal-ground)
                color: var(--c-signal)
        .mark
            position: absolute
            top: 50%
            right: 7px
            transform: translateY(-50%)
            color: var(--c-accent)
            pointer-events: none
        &:focus-within .mark
            color: var(--c-signal)
        .drop
            position: absolute
            top: 100%
            left: 0
            right: 0
            z-index: 1
            margin: 2px 0 0 0
            padding: 2px 0
            list-style: none
            border: 1px solid var(--c-signal)
            border-radius: 4px
            background: var(--c-paper)
            box-shadow: 0 4px 12px unquote("color-mix(in srgb, var(--c-shade) 18%, transparent)")
            font-family: "DejaVu Sans Mono", monospace
            font-size: 0.875em
            li
                padding: 1px 6px
                color: var(--c-signal)
                cursor: pointer
                &:hover
                    background: var(--c-signal-ground)
                &.sel
                    background: var(--c-signal)
                    color: var(--c-paper)
    textarea
        width: min(640px, 80vw)
        padding: 6px 8px
        border: 1px solid var(--c-accent)
        border-radius: 4px
        background: var(--c-accent-ground)
        color: var(--c-accent)
        font: inherit
        font-family: "DejaVu Sans Mono", monospace
        font-size: 0.875em
        resize: vertical
        &:focus
            outline: none
            border-color: var(--c-signal)
            background: var(--c-signal-ground)
            color: var(--c-signal)
        &:disabled
            border-color: var(--c-mute)
            background: transparent
            color: var(--c-mute)
            resize: none
            cursor: not-allowed
    .buttons button
        border-color: var(--c-accent)
        background: var(--c-accent-ground)
        color: var(--c-accent)
        &:hover, &:focus-visible
            outline: none
            border-color: var(--c-signal)
            background: var(--c-signal-ground)
            color: var(--c-signal)

/*  the transfer popup: in accent color, with a scrollable list of the lane states
    (in bold, behind their group), where the hovered and selected states change
    only their color (to keep the width) and the unselectable states are dimmed  */
#transfer
    .box
        border-color: var(--c-accent)
    .ask
        color: var(--c-accent)
        .cid
            margin-right: 0
    .states
        display: flex
        flex-direction: column
        align-self: stretch
        max-height: 60vh
        overflow-y: auto
        button
            border: none
            padding: 2px 12px
            background: var(--c-paper)
            color: var(--c-text)
            font: inherit
            text-align: left
            cursor: pointer
            &:hover:enabled, &.sel
                color: var(--c-signal)
            &:disabled
                color: var(--c-mute)
                cursor: default
        .state
            font-weight: bold
        .cur
            color: var(--c-text-soft)
            font-weight: normal

/*  the assign popup: in accent color, with its question in normal color (but bold), and
    with the assignee field in the style of the request name field of the prompt popup (in
    signal color, as it is always focused), with a marker of an unknown assignee, and with
    the drop-down of the suggested assignees (with the icons of their kind) directly below
    it, which stays in the flow of the popup, as it is always shown  */
#assign
    .box
        border-color: var(--c-accent)
    .ask
        color: var(--c-text)
        .cid
            margin-right: 0
    .combo
        position: relative
        width: min(360px, 70vw)
        input
            width: 100%
            box-sizing: border-box
            padding: 2px 22px 2px 6px
            border: 1px solid var(--c-signal)
            border-radius: 4px
            background: var(--c-signal-ground)
            color: var(--c-signal)
            font: inherit
            font-family: "DejaVu Sans Mono", monospace
            font-size: 0.875em
            &:focus
                outline: none
        .unknown
            position: absolute
            top: 6px
            right: 22px
            padding: 0 4px
            border-radius: 3px
            background: var(--c-signal)
            color: var(--c-paper)
            font-size: 0.6875rem
            pointer-events: none
        .mark
            position: absolute
            top: 6px
            right: 7px
            color: var(--c-signal)
            pointer-events: none
        .drop
            max-height: 10.5em
            overflow-y: auto
            margin: 2px 0 0 0
            padding: 2px 0
            list-style: none
            border: 1px solid var(--c-signal)
            border-radius: 4px
            background: var(--c-paper)
            font-family: "DejaVu Sans Mono", monospace
            font-size: 0.875em
            li
                padding: 1px 6px
                color: var(--c-signal)
                cursor: pointer
                &:hover
                    background: var(--c-signal-ground)
                &.sel
                    background: var(--c-signal)
                    color: var(--c-paper)
            .icon
                display: inline-block
                width: 1.5em
    .buttons button
        border-color: var(--c-accent)
        background: var(--c-accent-ground)
        color: var(--c-accent)
        &:hover, &:focus-visible
            outline: none
            border-color: var(--c-signal)
            background: var(--c-signal-ground)
            color: var(--c-signal)

/*  the modal busy popup: in accent color, above all other popups, with a
    rotating spinner and an indeterminate progress bar with a bouncing block  */
#busy
    z-index: 30
    cursor: progress
    .box
        border-color: var(--c-accent)
        padding: 16px 24px
    .ask
        display: flex
        align-items: center
        gap: 8px
        color: var(--c-accent)
        .cid
            margin-right: 0
            background: var(--c-accent)
        .time
            color: var(--c-text-soft)
            font-weight: normal
    .spinner
        width: 12px
        height: 12px
        border: 2px solid var(--c-accent-line)
        border-top-color: var(--c-accent)
        border-radius: 50%
        animation: busy-spin 0.8s linear infinite
    .bar
        position: relative
        width: 320px
        max-width: 70vw
        margin: 8px 0
        height: 12px
        overflow: hidden
        border-radius: 6px
        background: var(--c-accent-line)
        .block
            position: absolute
            top: 0
            width: 25%
            height: 100%
            border-radius: 6px
            background: var(--c-accent)
            animation: busy-bounce 1.6s ease-in-out infinite alternate
@keyframes busy-spin
    to
        transform: rotate(360deg)
@keyframes busy-bounce
    from
        left: 0
    to
        left: 75%
#dlg
    position: absolute
    left: 50%
    top: 1.5vh
    transform: translateX(-50%)
    width: unquote("min(900px, 94vw)")
    height: 97vh
    display: flex
    flex-direction: column
    background: var(--c-paper)
    border: 1px solid var(--c-border-strong)
    border-radius: 10px
    box-shadow: 0 8px 32px unquote("color-mix(in srgb, var(--c-shade) 18%, transparent)")

    /*  the header: task id and title on the left, lane group and lane on the right  */
    .dhd
        display: flex
        align-items: center
        gap: 12px
        padding: 4px 16px 4px 20px
        background: var(--c-ground)
        border-bottom: 1px solid var(--c-fill)
        border-radius: 10px 10px 0 0
        h1
            flex: 1
            min-width: 0
            margin: 0
            font-size: 1rem
            white-space: nowrap
            overflow: hidden
            text-overflow: ellipsis

            /*  the inline code of the task title, in the code font  */
            code
                font-family: "DejaVu Sans Mono", Menlo, monospace
                font-size: 0.9em
                letter-spacing: -0.015em

            /*  the task title colored like its task box (the task id box
                gets its color from the general task box tone rules)  */
            color: var(--c-text)
            &.tone-active
                color: var(--c-accent-strong)
            &.tone-done
                color: var(--c-line)
        .where
            white-space: nowrap
            color: var(--c-text-soft)
            .val
                display: inline-block
                padding: 0 6px
                border: 1px solid var(--c-border)
                border-radius: 4px
                background: var(--c-paper)
                color: var(--c-text)
                font-weight: bold

    /*  the dependencies: predecessors on the left, successors on the right  */
    .drefs
        display: flex
        justify-content: space-between
        flex-wrap: wrap
        gap: 6px 24px
        padding: 4px 20px
        background: var(--c-ground)
        border-bottom: 1px solid var(--c-fill)
        .mute
            margin-right: 6px
            font-size: 1rem

    /*  the tabs: the task plan, followed by its attachments, all filled,
        the selected one in signal color, the others in accent color  */
    .dtabs
        position: relative
        display: flex
        align-items: center
        gap: 6px
        padding: 4px 20px
        background: var(--c-ground)
        border-bottom: 1px solid var(--c-fill)

        /*  the scroll arrows sit in the side paddings, so the tabs start
            in the same left column as the other rows of the dialog  */
        .tarr
            position: absolute
            top: 50%
            transform: translateY(-50%)
            border: 0
            background: none
            padding: 0
            cursor: pointer
            color: var(--c-mute)
            font-size: 0.875rem
            &:first-child
                left: 5px
            &:last-child
                right: 5px
        .tlist
            flex: 1
            min-width: 0
            display: flex
            gap: 6px
            overflow-x: auto
            scrollbar-width: none
            &::-webkit-scrollbar
                display: none
        .tab
            flex-shrink: 0
            border: 1px solid var(--c-accent)
            border-radius: 4px
            padding: 1px 8px
            background: var(--c-accent)
            color: var(--c-paper)
            font: inherit
            font-size: 0.875rem
            white-space: nowrap
            cursor: pointer
            &.sel
                border-color: var(--c-signal)
                background: var(--c-signal)
                font-weight: bold
            &:hover
                opacity: 0.8

    /*  the content: the rendered task plan or attachment of the selected tab  */

    /*  the content fills the remaining height of the fixed-height dialog,
        so the dialog keeps the same margin at the top and the bottom  */
    #plan
        flex: 1
        min-height: 0
        width: 100%
        border: 0

    /*  the task plan editor (CodeMirror), in the code font, with the
        same horizontal padding as the rows of the task dialog  */
    #editor
        flex: 1
        min-height: 0
        overflow: hidden
        background: var(--c-paper)
        .cm-editor
            height: 100%
            color: var(--c-text)
            &.cm-focused
                outline: none
        .cm-scroller
            font-family: "DejaVu Sans Mono", Menlo, monospace
            font-size: 0.9rem
            line-height: 1.3
        .cm-content
            padding: 1.2rem 0 2rem 0
            caret-color: transparent
        .cm-line
            padding: 0 20px

        /*  the cursor as a filled block in the signal color with a white character
            (also the block cursor of the Vim key bindings), outlined only while unfocused,
            replacing the regular line cursor  */
        .cm-cursor
            display: none
        .cm-block-cursor, .cm-fat-cursor
            background: var(--c-signal)
            color: #ffffff !important
            *
                color: #ffffff !important
        .cm-editor:not(.cm-focused)
            .cm-block-cursor, .cm-fat-cursor
                background: none
                color: inherit !important
                outline: 1px solid var(--c-signal)
                *
                    color: inherit !important
        .cm-selectionBackground, &.cm-focused .cm-selectionBackground
            background: var(--c-accent-fill)

        /*  the status and command line of the Vim and Emacs key bindings  */
        .cm-panels
            background: var(--c-ground)
            border-top: 1px solid var(--c-fill)
            color: var(--c-text-soft)
            font-family: "DejaVu Sans Mono", Menlo, monospace
            font-size: 0.8125rem
            padding: 0 20px

    /*  the notice of the task plan editor, with its action buttons  */
    .dnote
        display: flex
        align-items: center
        gap: 8px
        padding: 4px 20px
        background: var(--c-signal-ground)
        border-bottom: 1px solid var(--c-fill)
        color: var(--c-signal)
        font-size: 0.875rem
        button
            border: 1px solid var(--c-signal)
            border-radius: 4px
            padding: 0 8px
            background: var(--c-paper)
            color: var(--c-signal)
            font: inherit
            cursor: pointer
            &:hover
                background: var(--c-signal)
                color: var(--c-paper)

    /*  the footer: the key hint  */
    .dfoot
        padding: 6px 20px
        background: var(--c-ground)
        border-top: 1px solid var(--c-fill)
        border-radius: 0 0 10px 10px
        color: var(--c-text-soft)
        font-size: 0.6875rem

        /*  the separators between the key hints  */
        .sep
            margin: 0 0.6rem
            color: var(--c-mute)

        /*  the actions after the key caps of the key hints  */
        .action
            margin-left: 0.4rem
.close
    border: 0
    background: none
    font-size: 1rem
    cursor: pointer
    color: var(--c-text)

/*  the task id references to the predecessors and successors, filled
    like the task id boxes: accent for active, dim for done, else default  */
.ref
    cursor: pointer
    &.tone-active
        background: var(--c-accent)
    &.tone-done
        background: var(--c-line)
    &:hover
        opacity: 0.8

/*  the task plan document (shown within the task dialog): the frontmatter
    fields, the numbered plan sections, and the attachments  */
body.plan
    background: var(--c-paper)
    margin: 0

    /*  the same horizontal padding as the rows of the task dialog, to align on the left  */
    padding: 0.8rem 20px 2rem 20px
    font-size: 1rem
    line-height: 1.30
    h1, h2, h3, h4
        color: var(--c-accent)
        line-height: 1.25
        margin: 1.0em 0 0.5em
    h1
        font-size: 1.4rem
    h2
        font-size: 1.2rem
    h3
        font-size: 1.05rem
    p, ol, ul, table, pre, blockquote
        margin: 0 0 0.8em

    /*  the list items (of loose lists, where the item texts are paragraphs) with less spacing  */
    li > p
        margin: 0 0 0.5em

    /*  bullet lists with filled round bullets (also for the checklist items)  */
    ul
        list-style: disc
        padding-left: 1rem

        /*  more space between the (fixed) bullet and the item text  */
        > li
            padding-left: 0.8rem
    ol
        padding-left: 1.6rem
    a
        color: var(--c-accent)
    img
        max-width: 100%
        height: auto

        /*  an SVG attachment fits the tab width, as it may lack an intrinsic size  */
        &.svg
            width: 100%

    /*  an embedded attachment image is zoomed with the mouse wheel and panned by dragging  */
    .embedding img
        cursor: grab
    hr
        border: 0
        border-top: 1px solid var(--c-fill)

        /*  the separator between the task fields and the task plan  */
        &.fields
            margin: 0 0 0.6rem 0

            /*  a text attachment directly after the separator without extra top padding  */
            & + pre.textart
                padding-top: 0
    blockquote
        padding: 0.1em 0 0.1em 0.9em
        border-left: 3px solid var(--c-accent-border)
        color: var(--c-text-soft)
    /*  the code font size relative to the surrounding text,
        to scale along within the larger headers  */
    code
        font-family: "DejaVu Sans Mono", Menlo, monospace
        font-size: 0.9em
        letter-spacing: -0.015em
        color: var(--c-accent)
    pre.textart
        white-space: pre
        overflow-x: auto
        line-height: 1.15
        font-size: 0.9rem
        padding: 0.6rem 0
        code
            font-size: 0.9rem
            padding: 0

    /*  a draft diff: headers dimmed, inserted lines accented, removed lines signaled  */
    pre.diff code
        color: var(--c-text)
        letter-spacing: -0.015em
        line-height: 1.00
        .head
            color: var(--c-mute)
        .add
            color: var(--c-accent)
        .del
            color: var(--c-signal)

    /*  YAML or JSON data: keys accented, numbers and literals signaled,
        indicators and comments dimmed, and strings in the text color  */
    pre.data code
        color: var(--c-text)
        .key
            color: var(--c-accent)
        .num, .lit
            color: var(--c-signal)
        .punct
            color: var(--c-mute)
        .cmt
            color: var(--c-mute)
            font-style: italic
    table
        border-collapse: collapse
        th, td
            padding: 0.25em 0.6em
            border: 1px solid var(--c-border-soft)
            text-align: left
            vertical-align: top
        th
            background: var(--c-ground)
    table.fields
        margin-bottom: 0.6rem
        line-height: 1.25
        td
            padding: 0 1.2rem 0 0
            border: 0
            &.k
                color: var(--c-mute)
                &::after
                    content: ":"
    .diagram
        overflow-x: auto
        margin: 0 0 0.8em
        svg
            max-width: 100%
            height: auto
    .caption
        margin-top: 0.2rem
        color: var(--c-mute)
        font-size: 0.85rem

    /*  the checkboxes of the checklist items  */
    .box
        display: inline-block
        width: 0.75em
        height: 0.75em
        margin-right: 0.5em
        vertical-align: -0.05em
        border: 1px solid var(--c-accent)
        border-radius: 2px
        &.done
            background: var(--c-accent)
        &.part
            background: linear-gradient(90deg, var(--c-accent) 50%, var(--c-accent-ground) 50%)
        &.todo
            background: var(--c-accent-ground)

        /*  the open, cancelled, and deferred items as regular glyphs
            within a fixed-size box with a rounded signal border  */
        &.open, &.cancel, &.defer
            overflow: hidden
            border-color: var(--c-signal)
            background: var(--c-signal-ground)
            color: var(--c-signal)
            &::before
                display: flex
                align-items: center
                justify-content: center
                height: 100%
                font-size: 0.7em
                font-weight: bold
                line-height: 1
        &.open::before
            content: "?"
        &.cancel::before
            content: "−"
        &.defer::before
            content: "→"

