    "bin":                                  { "ase": "bin/ase" },
    "devDependencies": {
        "eslint":                           "10.11.0",
        "@eslint/js":                       "10.0.1",
        "@typescript-eslint/parser":        "8.70.1",
        "@typescript-eslint/eslint-plugin": "8.70.1",
        "typescript-eslint":                "8.70.1",
        "eslint-plugin-promise":            "7.3.0",
        "neostandard":                      "0.14.0-next.1",
        "globals":                          "17.12.0",
        "typescript":                       "6.0.3",

        "@rse/stx":                         "1.1.7",
        "nodemon":                          "3.1.14",
        "shx":                              "0.4.0",

        "@types/node":                      "26.6.3",
        "@types/luxon":                     "3.7.5",
        "@types/which":                     "3.0.4",
        "@types/update-notifier":           "6.0.8",
