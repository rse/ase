        "@types/proper-lockfile":           "4.1.4",
        "@types/write-file-atomic":         "4.0.3",
        "@types/tail":                      "2.2.3",
        "@types/pacote":                    "11.1.8",
        "@types/picomatch":                 "4.0.3",
        "@types/ws":                        "8.18.1"
    },
    "dependencies": {
        "commander":                        "15.0.0",
        "@dotenvx/dotenvx":                 "2.30.0",
        "yaml":                             "2.9.1",
        "valibot":                          "1.5.0",
        "execa":                            "10.0.1",
        "mkdirp":                           "3.0.1",
        "@hapi/hapi":                       "21.4.10",
        "beautiful-mermaid":                "1.1.3",
        "cli-table3":                       "0.6.5",
        "chalk":                            "6.0.0",
        "pretty-ms":                        "9.3.1",
        "luxon":                            "3.7.2",
        "@modelcontextprotocol/sdk":        "1.30.1",
        "json-asty":                        "1.3.4",
        "zod":                              "4.6.5",
        "which":                            "7.0.0",
        "update-notifier":                  "7.3.1",
        "shell-quote":                      "1.10.0",
        "get-stdin":                        "10.0.0",
        "proper-lockfile":                  "4.1.2",
        "write-file-atomic":                "8.0.0",
        "p-queue":                          "9.3.3",
        "pacote":                           "22.0.0",
        "ofetch":                           "1.5.1",
        "undici":                           "8.11.2",
        "picomatch":                        "4.0.7",
        "lru-cache":                        "11.5.3",
        "@rse/specbook":                    "1.3.1",
        "tail":                             "2.2.6",
        "source-code-error":                "1.2.0",
        "pure-uuid":                        "2.0.0",
        "ws":                               "8.21.3"
