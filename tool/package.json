    "allowScripts": {
        "fsevents":                         true
    },
    "engines": {
        "npm":                              ">=10.0.0",
        "node":                             ">=22.13.0"
    },
    "upd": [
        "!typescript"
    ],
    "files": [
        "dst/**/*",
        "bin/**/*",
        "plugin/**/*",
        "!plugin/node_modules/**",
        "!plugin/package.json",
        "!plugin/etc/**",
        ".claude-plugin/**/*",
        "README.md"
    ],
    "scripts": {
        "start":                            "stx -v4 -l warning -c etc/stx.conf"
    }
