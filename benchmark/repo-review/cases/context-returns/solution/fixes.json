                    "        return"
                ],
                "replace": [
                    "        if (refund.status !== \"settled\")",
                    "            settleRefund(order, refund)",
                    "        return"
                ]
            }
        ],
        "B-08": [
            {
                "file": "src/admin.ts",
                "find": [
