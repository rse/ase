                "replace": [
                    "            to:      order.customer.email,"
                ]
            }
        ],
        "B-03": [
            {
                "file": "src/credit.ts",
                "find": [
                    "    await book({ customerId, amount: -amount, reference })",
                    "    balances.set(customerId, balance - amount)"
                ],
                "replace": [
                    "    balances.set(customerId, balance - amount)",
                    "    try {",
                    "        await book({ customerId, amount: -amount, reference })",
                    "    }",
                    "    catch (err) {",
                    "        balances.set(customerId, creditBalance(customerId) + amount)",
                    "        throw err",
                    "    }"
                ]
            }
        ],
        "B-04": [
            {
                "file": "src/returns.ts",
