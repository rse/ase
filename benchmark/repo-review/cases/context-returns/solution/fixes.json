{
    "version": 1,
    "fixes": {
        "B-01": [
            {
                "file": "src/returns.ts",
                "find": [
                    "    for (let i = 1; i < lines.length; i++)"
                ],
                "replace": [
                    "    for (let i = 0; i < lines.length; i++)"
                ]
            }
        ],
        "B-02": [
            {
                "file": "src/mail.ts",
                "find": [
                    "            to:      order.id,"
