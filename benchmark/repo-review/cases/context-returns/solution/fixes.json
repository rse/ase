                    "import { refundedTotal } from \"./refund\""
                ]
            },
            {
                "file": "src/report.ts",
                "find": [
                    "        if (order.status === \"paid\")",
                    "            sum += order.total"
                ],
                "replace": [
                    "        if (order.status === \"paid\" || order.status === \"partially_refunded\")",
                    "            sum += order.total - refundedTotal(order.id)"
                ]
            }
        ],
        "B-06": [
            {
