                ]
            },
            {
                "file": "src/returns.ts",
                "find": [
                    "/*  a parcel was checked in at the returns desk  */"
                ],
                "replace": [
                    "/*  whether these lines bring back the last units of the order  */",
                    "function completesOrder(order: Order, lines: ReturnLine[]): boolean {",
                    "    return order.items.every((item) => {",
                    "        const line = lines.find((l) => l.sku === item.sku)",
                    "        return returnedQuantity(order.id, item.sku) + (line?.quantity ?? 0) === item.quantity",
                    "    })",
                    "}",
                    "",
                    "/*  a parcel was checked in at the returns desk  */"
                ]
            },
            {
                "file": "src/returns.ts",
                "find": [
                    "    const amount = returnAmount(order, lines)"
                ],
                "replace": [
                    "    /*  the parcel that brings back the rest of the order is paid back the rest of the total  */",
                    "    const share  = returnAmount(order, lines)",
                    "    const amount = completesOrder(order, lines) ? refundable(order) : share"
                ]
            }
        ],
        "B-05": [
            {
                "file": "src/report.ts",
                "find": [
                    "import type { Order } from \"./order\""
                ],
                "replace": [
