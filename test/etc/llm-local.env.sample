##
##  ASE skill test harness: LLM gateway profile (sample)
##
##  Routes the harness and its sandboxed agent sessions to an Anthropic-compatible
##  gateway (e.g. a LiteLLM proxy in front of a locally served model) instead of
##  the Anthropic API. Copy to e.g. "etc/llm-local.env", adjust, then run:
##
##      npm start test -- --llm=etc/llm-local.env --cases=<glob>
##
##  Variables already exported in the environment take precedence over this file.
##

#   the Anthropic-compatible endpoint and its credential
#   (for LiteLLM: the proxy base URL and its master key)
ANTHROPIC_BASE_URL=http://127.0.0.1:4000
ANTHROPIC_API_KEY=sk-REPLACE-WITH-LITELLM-MASTER-KEY

#   tame Claude Code for a small local context window
CLAUDE_CODE_AUTO_COMPACT_WINDOW=65000
CLAUDE_CODE_MAX_OUTPUT_TOKENS=8192
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

#   optional explicit model overrides (usually unnecessary: let the gateway
#   alias the "claude-*" model names onto its local model instead)
#ASE_TEST_MODEL=default_model
#ASE_TEST_JUDGE_MODEL=default_model
#ASE_TEST_SIM_MODEL=default_model
